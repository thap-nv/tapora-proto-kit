{
  "dialect": "postgresql",
  "tenant_column": "organization_id",
  "global_tables": ["organizations", "appointment_services", "invoice_lines", "doctor_specialties"],
  "audit_fk_suffixes": ["_by"],
  "volumes": {
    "organizations": "S",
    "clinics": "S",
    "people": "M",
    "patients": "M",
    "doctors": "S",
    "users": "S",
    "rooms": "S",
    "services": "S",
    "specialties": "S",
    "doctor_specialties": "S",
    "doctor_schedules": "S",
    "appointments": "L",
    "appointment_services": "L",
    "invoices": "L",
    "invoice_lines": "L",
    "payments": "L",
    "appointment_deposits": "M",
    "patient_guardianships": "S",
    "internal_notes": "M",
    "patient_allergies": "M",
    "patient_insurances": "M",
    "password_reset_tokens": "S"
  },
  "access_patterns": [
    { "id": "AP-01", "desc": "Lịch hẹn của một phòng khám theo ngày (lễ tân, báo cáo theo phòng khám — thay cho bảng riêng từng chi nhánh, N-19)", "source": "R-10, R-11, N-19", "table": "appointments",
      "eq": ["organization_id", "clinic_id"], "sort": ["starts_at"], "range": ["starts_at"], "freq": "hot" },
    { "id": "AP-02", "desc": "Lịch hẹn của một bệnh nhân, mới nhất trước; cũng là bước một của tra hóa đơn theo bệnh nhân và đếm số lần khám hoàn thành (N-10, N-12)", "source": "R-03, N-10, N-12", "table": "appointments",
      "eq": ["organization_id", "patient_id"], "sort": ["starts_at desc"], "range": [], "freq": "hot" },
    { "id": "AP-03", "desc": "Các khoản thanh toán của một hóa đơn", "source": "R-08", "table": "payments",
      "eq": ["organization_id", "invoice_id"], "sort": [], "range": [], "freq": "hot" },
    { "id": "AP-04", "desc": "Hóa đơn theo lịch hẹn (N-12); bước hai của tra hóa đơn theo bệnh nhân", "source": "N-12", "table": "invoices",
      "eq": ["appointment_id"], "sort": [], "range": [], "freq": "hot" },
    { "id": "AP-05", "desc": "Lịch của một bác sĩ theo khoảng ngày", "source": "R-04, R-05, N-02", "table": "appointments",
      "eq": ["organization_id", "doctor_id"], "sort": ["starts_at"], "range": ["starts_at"], "freq": "hot" },
    { "id": "AP-06", "desc": "Lễ tân tra bệnh nhân theo chất gây dị ứng", "source": "N-07", "table": "patient_allergies",
      "eq": ["organization_id", "lower(substance)"], "sort": [], "range": [], "freq": "warm" },
    { "id": "AP-07", "desc": "Dị ứng của một bệnh nhân", "source": "N-07", "table": "patient_allergies",
      "eq": ["patient_id"], "sort": [], "range": [], "freq": "hot" },
    { "id": "AP-08", "desc": "Bác sĩ theo chuyên khoa (tra ngược)", "source": "N-08", "table": "doctor_specialties",
      "eq": ["specialty_id"], "sort": [], "range": [], "freq": "warm" },
    { "id": "AP-09", "desc": "Ghi chú nội bộ của một bệnh nhân, mới nhất trước", "source": "N-06", "table": "internal_notes",
      "eq": ["patient_id"], "sort": ["created_at desc"], "range": [], "freq": "warm" }
  ],
  "waivers": [
    { "rule": "DB-INT-08", "target": "password_reset_tokens.token_hash", "reason": "Liên kết đặt lại mật khẩu chỉ mang mã ngẫu nhiên, hệ thống tra dòng bằng mã này TRƯỚC khi biết tổ chức; mã 256 bit nên unique toàn cục không tranh chấp giữa tổ chức và không lộ thông tin (N-14)" },
    { "rule": "DB-IDX-12", "target": "patients.person_id", "reason": "Cố ý unique đầy đủ: một người tối đa một hồ sơ bệnh nhân kể cả hồ sơ đã ẩn (R-03); quay lại khám thì khôi phục hồ sơ cũ, không mở hồ sơ thứ hai. Chỉ mã hồ sơ (record_code) được nhả khi ẩn (N-04)" }
  ],
  "diagram": { "infra_columns": ["organization_id"] },
  "requirement_code_pattern": "R-\\d+|N-\\d+"
}
