// =====================================================================
//  Phòng khám đa khoa chuỗi — đặt lịch khám
//  v1.0 2026-09-01 — schema hiện có của dự án mẫu (đề đo db-r1)
//  v1.1 2026-10-07 — giai đoạn 2: áp nhu cầu dữ liệu N-01 → N-20
//                    (1-yeu-cau/NHU-CAU-DU-LIEU-MOI.md); phần chưa dựng
//                    và giả định ghi ở docs/database/CAU-HOI-BA.md
//  Nguồn: 1-yeu-cau/YEU-CAU-PHONG-KHAM.md (R-01 → R-12)
// =====================================================================

Project clinic_chain {
  database_type: 'PostgreSQL'
  Note: '''
    Chuỗi phòng khám đa khoa, nhiều phòng khám thuộc một tổ chức (organization).
    Mọi bảng nghiệp vụ mang organization_id. Múi giờ lưu UTC.
    v1.1 cần CREATE EXTENSION btree_gist (EXCLUDE chống chồng lấn ở appointments, guardianships).
  '''
}

Enum user_role {
  admin
  receptionist
  doctor
}

Enum appointment_status {
  booked
  done
  cancelled
  confirmed
  arrived
  no_show
}

Enum payment_method {
  cash
  card
  transfer
}

Enum allergy_severity {
  mild
  severe
}

Table organizations {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(160) [not null]
  created_at timestamptz [not null, default: `now()`]
}

Table clinics {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null, ref: > organizations.id]
  name varchar(160) [not null]
  address varchar(255)
  created_at timestamptz [not null, default: `now()`]

  Note: 'Một phòng khám (chi nhánh). Nguồn: R-01. Báo cáo theo chi nhánh lọc bằng clinic_id, không tách bảng theo chi nhánh (N-19).'
}

Table people {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null, ref: > organizations.id]
  full_name varchar(160) [not null]
  phone varchar(20)
  email varchar(160)
  birth_date date
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    (organization_id, full_name)
  }

  Note: '''
    Một dòng = một con người. Danh tính nằm ở đây, vai ở các bảng patients, doctors, users. Nguồn: R-02.
    Một người giữ nhiều vai cùng lúc: lễ tân cũng là bệnh nhân = một dòng people + một dòng users (role receptionist) + một dòng patients (N-03).
  '''
}

Table patients {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null, ref: > organizations.id]
  person_id uuid [not null, unique, ref: - people.id]
  record_code varchar(20) [not null, note: 'Mã hồ sơ bệnh nhân. Duy nhất trong tổ chức giữa các hồ sơ chưa ẩn, so không phân biệt hoa thường (🔴 A); hồ sơ đã ẩn nhả mã để cấp lại cho người khác (N-04).']
  created_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  Note: '''
    Hồ sơ bệnh nhân. Một người tối đa một hồ sơ bệnh nhân. Nguồn: R-02, R-03.
    Mã hồ sơ (N-04) — unique một phần, cho cấp lại mã của hồ sơ đã ẩn:
      CREATE UNIQUE INDEX patients_org_record_code_uq ON patients (organization_id, lower(record_code)) WHERE deleted_at IS NULL;
    Ẩn bệnh nhân (N-13) = đặt deleted_at, không xóa dòng. Hóa đơn và thanh toán giữ nguyên: khóa ngoại appointments → invoices → payments (mặc định NO ACTION) chặn xóa cứng.
    Trong cùng giao dịch, trigger AFTER UPDATE OF deleted_at hủy lịch hẹn tương lai:
      UPDATE appointments SET status = 'cancelled'
      WHERE patient_id = NEW.id AND starts_at > now() AND status IN ('booked', 'confirmed');
  '''
}

Table doctors {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null, ref: > organizations.id]
  person_id uuid [not null, unique, ref: - people.id]
  clinic_id uuid [not null, ref: > clinics.id]
  created_at timestamptz [not null, default: `now()`]

  Note: 'Hồ sơ bác sĩ; mỗi bác sĩ thuộc một phòng khám chính. Nguồn: R-02, R-05. Chuyên khoa ở doctor_specialties (N-08).'
}

Table users {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null, ref: > organizations.id]
  person_id uuid [not null, ref: > people.id]
  role user_role [not null]
  login_email varchar(160) [not null]
  password_hash varchar(255) [not null]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (organization_id, login_email) [unique]
  }

  Note: '''
    Tài khoản đăng nhập. Một người có thể có nhiều tài khoản, mỗi vai một dòng. Nguồn: R-09.
    Bác sĩ đăng nhập cổng riêng bằng email và mật khẩu = dòng role doctor (N-14). Chỉ lưu bản băm; không lưu mật khẩu đọc được.
  '''
}

Table rooms {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null, ref: > organizations.id]
  clinic_id uuid [not null, ref: > clinics.id]
  name varchar(80) [not null]

  indexes {
    (clinic_id, name) [unique]
  }

  Note: 'Phòng khám bệnh trong một phòng khám. Nguồn: R-06.'
}

Table services {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null, ref: > organizations.id]
  code varchar(20) [not null, note: 'Mã dịch vụ, ví dụ KHAM-TQ. Duy nhất trong mỗi tổ chức, so không phân biệt hoa thường (🔴 A); hai tổ chức dùng trùng mã được (N-11).']
  name varchar(160) [not null]
  price numeric(12,2) [not null]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (organization_id, `lower(code)`) [unique, name: 'services_org_code_uq']
  }

  Note: '''
    Danh mục dịch vụ và giá hiện hành. Nguồn: R-07.
    Dịch vụ ngưng dùng thì is_active = false và giữ mã — không cấp lại mã dịch vụ, vì dòng lịch hẹn cũ còn trỏ tới (N-11).
    Giá ở đây là giá hiện hành; giá in hóa đơn là appointment_services.unit_price (N-01).
  '''
}

Table doctor_schedules {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null, ref: > organizations.id]
  doctor_id uuid [not null, ref: > doctors.id]
  weekday smallint [not null, note: '1 = thứ hai … 7 = chủ nhật']
  start_time time [not null]
  end_time time [not null]

  indexes {
    (doctor_id, weekday)
  }

  Note: 'Ca làm việc cố định hằng tuần của bác sĩ. Nguồn: R-05.'
}

Table appointments {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null, ref: > organizations.id]
  clinic_id uuid [not null, ref: > clinics.id]
  patient_id uuid [not null, ref: > patients.id]
  doctor_id uuid [not null, ref: > doctors.id]
  starts_at timestamptz [not null]
  ends_at timestamptz [not null, note: 'Giờ kết thúc lịch hẹn, lớn hơn starts_at. Khoảng [starts_at, ends_at) dùng cho EXCLUDE chống trùng lịch bác sĩ (N-02).']
  status appointment_status [not null, default: 'booked']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (organization_id, clinic_id, starts_at)
    (patient_id, starts_at)
    (doctor_id, starts_at)
  }

  Note: '''
    Lịch hẹn khám. Mỗi lịch hẹn có đúng một bác sĩ phụ trách (R-04). Nguồn: R-03, R-04.
    Chống trùng lịch bác sĩ (N-02) — cần btree_gist:
      CHECK (ends_at > starts_at)  — bảng lớn: ADD CONSTRAINT … NOT VALID rồi VALIDATE CONSTRAINT
      EXCLUDE không có NOT VALID: tạo sau khi điền ends_at cho dòng cũ (Q-09), vào giờ thấp điểm.
      ALTER TABLE appointments ADD CONSTRAINT appointments_doctor_no_overlap
        EXCLUDE USING gist (doctor_id WITH =, tstzrange(starts_at, ends_at, '[)') WITH &&)
        WHERE (status NOT IN ('cancelled', 'no_show'));
      Lịch đã hủy hay vắng mặt nhả chỗ (🔴 A, Q-10). Hai lịch nối đuôi 9:00–9:30 và 9:30–10:00 không chồng.
    Máy trạng thái (N-09; 🔴 A ở Q-08):
      booked → confirmed | cancelled
      confirmed → arrived | no_show
      arrived → done (🔴 A — N-09 không nêu bước sau "đã đến"; done là "đã khám" của R-08)
      confirmed → cancelled chỉ do hệ thống khi ẩn bệnh nhân (N-13; 🔴 A)
      done, no_show, cancelled là trạng thái cuối. Cưỡng chế bằng trigger BEFORE UPDATE OF status.
    Số lần khám đã hoàn thành của bệnh nhân (N-10) tính ra, không lưu:
      SELECT count(*) FROM appointments WHERE patient_id = :p AND status = 'done';  — đi index (patient_id, starts_at).
    Báo cáo theo chi nhánh (N-19) đi index (organization_id, clinic_id, starts_at); không tách bảng theo chi nhánh (Q-18).
  '''
}

Table appointment_services {
  appointment_id uuid [not null, ref: > appointments.id]
  service_id uuid [not null, ref: > services.id]
  quantity smallint [not null, default: 1]
  unit_price numeric(12,2) [not null, note: 'Đơn giá chép từ services.price lúc ghi nhận dịch vụ đã thực hiện; bảng giá đổi sau đó không ảnh hưởng. Hóa đơn in theo cột này (N-01).']

  indexes {
    (appointment_id, service_id) [pk]
  }

  Note: '''
    Dịch vụ được thực hiện trong một lịch hẹn. Nguồn: R-07.
    Giá lúc khám (N-01): unit_price chép một lần khi thêm dòng, không cập nhật theo services.price.
      CHECK (unit_price >= 0)  — bảng lớn: ADD CONSTRAINT … NOT VALID rồi VALIDATE CONSTRAINT
    Tiền một dòng = quantity × unit_price; tổng hóa đơn = cộng các dòng của lịch hẹn (tính ra, không lưu).
  '''
}

Table invoices {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null, ref: > organizations.id]
  appointment_id uuid [not null, ref: > appointments.id]
  issued_at timestamptz [not null, default: `now()`]

  indexes {
    (appointment_id)
  }

  Note: '''
    Hóa đơn của một lịch hẹn. Nguồn: R-08.
    Tra theo lịch hẹn (N-12): index (appointment_id).
    Tra theo bệnh nhân (N-12): appointments (patient_id, starts_at) → invoices (appointment_id) — một bệnh nhân vài chục lịch hẹn nên hai lần dò index, không chép patient_id vào đây (Q-19).
    Ẩn bệnh nhân không đụng hóa đơn (N-13): ẩn là đặt deleted_at, không xóa dòng; khóa ngoại tới appointments (mặc định NO ACTION) chặn xóa cứng.
  '''
}

Table payments {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null, ref: > organizations.id]
  invoice_id uuid [not null, ref: > invoices.id]
  amount numeric(12,2) [not null]
  method payment_method [not null]
  paid_at timestamptz [not null, default: `now()`]

  indexes {
    (invoice_id)
  }

  Note: 'Một khoản thanh toán cho hóa đơn. Hoàn tiền là dòng mới mang số âm. Nguồn: R-08. Giữ nguyên khi ẩn bệnh nhân (N-13).'
}

// ---------------------------------------------------------------------
//  v1.1 — bảng mới
// ---------------------------------------------------------------------

Table guardianships {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null]
  guardian_person_id uuid [not null, note: 'Người bảo hộ — bất kỳ ai trong people: bác sĩ, nhân viên hay phụ huynh không có vai nào khác (N-03).']
  ward_person_id uuid [not null, note: 'Người được bảo hộ — bệnh nhân nhỏ tuổi (N-03).']
  starts_on date [not null, note: 'Ngày bắt đầu bảo hộ (N-03).']
  ends_on date [note: 'Ngày kết thúc bảo hộ; trống = còn hiệu lực. 🔴 A — thêm cho pha kết thúc, N-03 chỉ nêu ngày bắt đầu (Q-12).']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (ward_person_id, starts_on)
    (guardian_person_id)
  }

  Note: '''
    Quan hệ bảo hộ giữa hai người: ai bảo hộ ai, từ ngày nào (N-03). Một dòng một giai đoạn; đổi người bảo hộ = đóng dòng cũ (ends_on) và thêm dòng mới, lịch sử giữ nguyên.
    CHECK (guardian_person_id <> ward_person_id)
    CHECK (ends_on IS NULL OR ends_on >= starts_on)
    EXCLUDE USING gist (guardian_person_id WITH =, ward_person_id WITH =, daterange(starts_on, ends_on, '[]') WITH &&)  — cùng một cặp không có hai giai đoạn chồng nhau.
    Dữ liệu về trẻ em: xem theo quyền đọc của R-10 (lễ tân phòng khám mình, quản trị viên toàn tổ chức); giữ theo hồ sơ bệnh nhân (🔴 A, Q-12).
  '''
}

Ref: guardianships.organization_id > organizations.id [delete: restrict]
Ref: guardianships.guardian_person_id > people.id [delete: restrict]
Ref: guardianships.ward_person_id > people.id [delete: restrict]

Table appointment_deposits {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null]
  appointment_id uuid [not null, unique, note: 'Lịch hẹn nhận cọc; mỗi lịch hẹn tối đa một khoản cọc (N-05).']
  amount numeric(12,2) [not null, note: 'Số tiền cọc, lớn hơn 0 (N-05).']
  received_on date [not null, note: 'Ngày nhận cọc (N-05).']
  created_at timestamptz [not null, default: `now()`]

  Note: '''
    Khoản đặt cọc của một lịch hẹn (N-05).
    CHECK (amount > 0)
    Chưa dựng: cọc được trừ vào hóa đơn, hoàn hay mất khi hủy / vắng mặt — chờ Q-14.
  '''
}

Ref: appointment_deposits.organization_id > organizations.id [delete: restrict]
Ref: appointment_deposits.appointment_id > appointments.id [delete: restrict]

Table internal_notes {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null]
  appointment_id uuid [note: 'Lịch hẹn được ghi chú; đúng một trong ba cột đích có giá trị (N-06).']
  patient_id uuid [note: 'Bệnh nhân được ghi chú; đúng một trong ba cột đích có giá trị (N-06).']
  invoice_id uuid [note: 'Hóa đơn được ghi chú; đúng một trong ba cột đích có giá trị (N-06).']
  author_user_id uuid [not null, note: 'Tài khoản nhân viên viết ghi chú (N-06).']
  body text [not null, note: 'Nội dung ghi chú nội bộ, chỉ nhân viên xem (N-06).']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    (appointment_id)
    (patient_id)
    (invoice_id)
    (author_user_id)
  }

  Note: '''
    Ghi chú nội bộ gắn vào một lịch hẹn, một bệnh nhân hoặc một hóa đơn (N-06). Ba khóa ngoại thật thay cặp loại + id.
    CHECK (num_nonnulls(appointment_id, patient_id, invoice_id) = 1)
    Sửa: người viết sửa body, updated_at đổi, không giữ bản cũ; xóa = deleted_at (🔴 A, Q-15).
    Phân loại: body là văn bản tự do, có thể chứa thông tin sức khỏe — coi là nhạy cảm, đọc theo R-10, không chép vào log ứng dụng.
  '''
}

Ref: internal_notes.organization_id > organizations.id [delete: restrict]
Ref: internal_notes.appointment_id > appointments.id [delete: cascade]
Ref: internal_notes.patient_id > patients.id [delete: cascade]
Ref: internal_notes.invoice_id > invoices.id [delete: cascade]
Ref: internal_notes.author_user_id > users.id [delete: restrict]

Table allergens {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null]
  name varchar(160) [not null, note: 'Tên chất gây dị ứng, duy nhất trong tổ chức, so không phân biệt hoa thường (N-07).']
  is_active boolean [not null, default: true, note: 'false = ngưng chọn cho dòng mới; dòng bệnh nhân cũ vẫn trỏ được (🔴 A, Q-16).']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (organization_id, `lower(name)`) [unique, name: 'allergens_org_name_uq']
  }

  Note: 'Danh mục chất gây dị ứng: một chất một dòng để tra bệnh nhân theo chất không lệch chính tả (N-07). Ai được thêm chất: 🔴 A, Q-16.'
}

Ref: allergens.organization_id > organizations.id [delete: restrict]

Table patient_allergies {
  organization_id uuid [not null]
  patient_id uuid [not null]
  allergen_id uuid [not null]
  severity allergy_severity [not null, note: 'Mức độ dị ứng: nhẹ hoặc nặng (N-07).']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (patient_id, allergen_id) [pk]
    (allergen_id)
  }

  Note: '''
    Dị ứng của bệnh nhân — nhiều dòng mỗi bệnh nhân, một dòng mỗi chất (N-07).
    Tra bệnh nhân theo chất: index (allergen_id).
    Dữ liệu sức khỏe — nhạy cảm: quyền đọc theo R-10, giữ theo hồ sơ bệnh nhân (🔴 A, Q-16).
  '''
}

Ref: patient_allergies.organization_id > organizations.id [delete: restrict]
Ref: patient_allergies.patient_id > patients.id [delete: cascade]
Ref: patient_allergies.allergen_id > allergens.id [delete: restrict]

Table specialties {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null]
  name varchar(120) [not null, note: 'Tên chuyên khoa, duy nhất trong tổ chức, so không phân biệt hoa thường (N-08).']
  is_active boolean [not null, default: true, note: 'Quản trị viên bớt chuyên khoa = false; dòng giữ lại để gán cũ không gãy (🔴 A) (N-08).']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (organization_id, `lower(name)`) [unique, name: 'specialties_org_name_uq']
  }

  Note: 'Danh mục chuyên khoa do quản trị viên thêm, bớt trên màn hình quản trị — dòng dữ liệu, không phải enum (N-08).'
}

Ref: specialties.organization_id > organizations.id [delete: restrict]

Table doctor_specialties {
  organization_id uuid [not null]
  doctor_id uuid [not null]
  specialty_id uuid [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (doctor_id, specialty_id) [pk]
    (specialty_id)
  }

  Note: 'Bác sĩ thuộc chuyên khoa — một bác sĩ nhiều chuyên khoa (N-08). Tìm bác sĩ theo chuyên khoa: index (specialty_id).'
}

Ref: doctor_specialties.organization_id > organizations.id [delete: restrict]
Ref: doctor_specialties.doctor_id > doctors.id [delete: cascade]
Ref: doctor_specialties.specialty_id > specialties.id [delete: restrict]

Table patient_insurances {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null]
  patient_id uuid [not null, unique, note: 'Bệnh nhân sở hữu hồ sơ bảo hiểm; mỗi bệnh nhân tối đa một (N-15).']
  card_number varchar(40) [not null, note: 'Số thẻ bảo hiểm — dữ liệu cá nhân, quyền đọc theo R-10 (N-15).']
  insurer_name varchar(160) [not null, note: 'Nhà bảo hiểm (N-15).']
  valid_until date [not null, note: 'Hạn dùng thẻ (N-15).']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Hồ sơ bảo hiểm của bệnh nhân, quan hệ 1–0..1 (N-15). Đổi thẻ = ghi đè, không giữ thẻ cũ (🔴 A, Q-17).'
}

Ref: patient_insurances.organization_id > organizations.id [delete: restrict]
Ref: patient_insurances.patient_id > patients.id [delete: cascade]
