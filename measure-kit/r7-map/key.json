{
  "de": "r7-map · Sóng Xanh",
  "ghi_chu": "Đáp án của đề đo sketch-to-map. Không chép vào thư mục chạy. Khớp tên: bỏ dấu, chữ thường; mỗi lựa chọn trong match là các cụm cách nhau bằng dấu cách, '_' là dấu cách trong cụm, cụm bắt đầu bằng '-' thì không được có. Một lựa chọn khớp là đủ.",
  "trapTypes": {
    "ngu-y-quy-tac": "ngụ ý trong quy tắc nghiệp vụ",
    "ma-tran-quyen": "chỉ có trong ma trận quyền",
    "ca-bien": "chỉ có trong ca biên",
    "tu-dong": "việc tự động có cấu hình",
    "hai-ten": "một việc mang hai tên",
    "phu-luc": "nằm trong phụ lục",
    "quan-tri-hiem": "quản trị hiếm dùng",
    "hang-loat": "thao tác hàng loạt",
    "bien-the-vai": "biến thể theo vai",
    "tong-quan": "nhắc ở tổng quan, đặc tả ở tài liệu khác",
    "xd-de": "quyết định XD đè đoạn cũ",
    "schema": "bước chuyển trạng thái chỉ có trong schema"
