// =====================================================================
//  Phòng khám đa khoa chuỗi — đặt lịch khám
//  v1.1 2026-10-07 — lượt cập nhật giai đoạn 2 (N-01 → N-20)
//  v1.0 2026-09-01 — schema hiện có của dự án mẫu (đề đo db-r1)
//  Nguồn: 1-yeu-cau/YEU-CAU-PHONG-KHAM.md (R-01 → R-12)
//         1-yeu-cau/NHU-CAU-DU-LIEU-MOI.md (N-01 → N-20)
//  Câu hỏi mở và nhu cầu cố ý chưa dựng: docs/database/CAU-HOI-BA.md
// =====================================================================

Project clinic_chain {
  database_type: 'PostgreSQL'
  Note: '''
    Chuỗi phòng khám đa khoa, nhiều phòng khám thuộc một tổ chức (organization).
    Mọi bảng nghiệp vụ mang organization_id. Múi giờ lưu UTC.
    Cần extension btree_gist (EXCLUDE chống chồng giờ của bác sĩ, N-02).
  '''
}

Enum user_role {
  admin
  receptionist
  doctor
}

// N-09 thêm confirmed, arrived, no_show. done giữ từ v1.0 (R-08, N-10 cần) — N-09 không liệt kê, xem Q-03.
Enum appointment_status {
  booked
  confirmed
  arrived
  no_show
  done
  cancelled
}

Enum payment_method {
  cash
  card
  transfer
}

// N-07: hai mức như nhu cầu viết (nặng / nhẹ).
Enum allergy_severity {
  mild
  severe
}

Table organizations {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(160) [not null]
  created_at timestamptz [not null, default: `now()`]
}

Table clinics {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null, ref: > organizations.id]
  name varchar(160) [not null]
  address varchar(255)
  created_at timestamptz [not null, default: `now()`]

  Note: 'Một phòng khám (chi nhánh). Nguồn: R-01.'
}

Table people {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null, ref: > organizations.id]
  full_name varchar(160) [not null]
  phone varchar(20)
  email varchar(160)
  birth_date date
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    (organization_id, full_name)
  }

  Note: '''
    Một dòng = một con người. Danh tính nằm ở đây, vai ở các bảng patients, doctors, users, guardianships. Nguồn: R-02.
    Một lễ tân đồng thời là bệnh nhân (N-03): cùng people.id, một dòng users và một dòng patients — không cần bảng mới.
  '''
}

Table patients {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null, ref: > organizations.id]
  person_id uuid [not null, unique, ref: - people.id]
  record_code varchar(20) [not null, note: 'Mã hồ sơ bệnh nhân, duy nhất trong tổ chức giữa các hồ sơ chưa ẩn; hồ sơ đã ẩn nhả mã để cấp lại cho người khác (N-04)']
  created_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz [note: 'Ẩn hồ sơ khỏi danh sách (N-13); không xóa dòng']

  Note: '''
    Hồ sơ bệnh nhân. Một người tối đa một hồ sơ bệnh nhân. Nguồn: R-02, R-03, N-04, N-13.
    Mã hồ sơ duy nhất giữa các hồ sơ chưa ẩn; ẩn hồ sơ thì mã được cấp lại (N-04; hệ quả cho kế toán ở Q-11):
    CREATE UNIQUE INDEX patients_record_code_active_uq ON patients (organization_id, record_code) WHERE deleted_at IS NULL;
    Ẩn hồ sơ = đặt deleted_at (N-13). Dòng không bị xóa; lịch hẹn, hóa đơn, thanh toán trỏ về bằng FK delete: restrict nên còn nguyên cho kế toán đối chiếu.
    Trigger AFTER UPDATE OF deleted_at (NULL → có giá trị): chuyển lịch hẹn của bệnh nhân có starts_at > now() sang cancelled.
    Lịch booked hủy được ngay; lịch confirmed chờ Q-03 (N-09 chưa cho confirmed → cancelled); cọc của lịch bị hủy chờ Q-12.
  '''
}

Table doctors {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null, ref: > organizations.id]
  person_id uuid [not null, unique, ref: - people.id]
  clinic_id uuid [not null, ref: > clinics.id]
  created_at timestamptz [not null, default: `now()`]

  Note: 'Hồ sơ bác sĩ; mỗi bác sĩ thuộc một phòng khám chính. Chuyên khoa ở doctor_specialties (N-08). Nguồn: R-02, R-05.'
}

Table users {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null, ref: > organizations.id]
  person_id uuid [not null, ref: > people.id]
  role user_role [not null]
  login_email varchar(160) [not null]
  password_hash varchar(255) [not null]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (organization_id, login_email) [unique]
  }

  Note: '''
    Tài khoản đăng nhập. Một người có thể có nhiều tài khoản, mỗi vai một dòng. Nguồn: R-09.
    Bác sĩ đăng nhập cổng riêng = dòng role doctor. Chỉ lưu bản băm mật khẩu (R-09); N-14 không dựng, xem Q-04.
  '''
}

Table rooms {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null, ref: > organizations.id]
  clinic_id uuid [not null, ref: > clinics.id]
  name varchar(80) [not null]

  indexes {
    (clinic_id, name) [unique]
  }

  Note: 'Phòng khám bệnh trong một phòng khám. Nguồn: R-06. Phòng mổ (N-17) chưa mô hình hóa, xem Q-06.'
}

Table services {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null, ref: > organizations.id]
  code varchar(30) [not null, note: 'Mã dịch vụ (ví dụ KHAM-TQ), duy nhất trong tổ chức, không phân biệt hoa thường; tổ chức khác dùng lại được (N-11)']
  name varchar(160) [not null]
  price numeric(12,2) [not null]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (organization_id, `lower(code)`) [unique, name: 'services_org_code_uq']
  }

  Note: 'Danh mục dịch vụ và giá hiện hành. Giá dùng cho hóa đơn là appointment_services.unit_price (N-01). Nguồn: R-07, N-11.'
}

Table doctor_schedules {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null, ref: > organizations.id]
  doctor_id uuid [not null, ref: > doctors.id]
  weekday smallint [not null, note: '1 = thứ hai … 7 = chủ nhật']
  start_time time [not null]
  end_time time [not null]

  indexes {
    (doctor_id, weekday)
  }

  Note: 'Ca làm việc cố định hằng tuần của bác sĩ. Nguồn: R-05.'
}

Table appointments {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null, ref: > organizations.id]
  clinic_id uuid [not null, ref: > clinics.id]
  patient_id uuid [not null]
  doctor_id uuid [not null, ref: > doctors.id]
  starts_at timestamptz [not null]
  ends_at timestamptz [not null, note: 'Giờ kết thúc lịch hẹn; khoảng [starts_at, ends_at) dùng để chặn bác sĩ trùng giờ (N-02)']
  status appointment_status [not null, default: 'booked']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (organization_id, clinic_id, starts_at)
    (patient_id, starts_at)
    (doctor_id, starts_at)
  }

  Note: '''
    Lịch hẹn khám. Mỗi lịch hẹn có đúng một bác sĩ phụ trách (R-04; N-16 nhiều bác sĩ chờ Q-05). Nguồn: R-03, R-04, N-02, N-09, N-13.
    Một bảng cho mọi chi nhánh; báo cáo theo chi nhánh đi index (organization_id, clinic_id, starts_at) — N-19, Q-14.
    Khoảng giờ nửa mở: ca 9:00–9:30 và 9:30–10:00 không coi là trùng (N-02).
    CHECK (ends_at > starts_at)
    ALTER TABLE appointments ADD CONSTRAINT appointments_doctor_no_overlap
      EXCLUDE USING gist (doctor_id WITH =, tstzrange(starts_at, ends_at, '[)') WITH &&)
      WHERE (status NOT IN ('cancelled', 'no_show'));
    🔴 A: lịch đã hủy hoặc vắng mặt nhả giờ để bác sĩ nhận lịch khác; lịch cũ v1.0 cần điền ends_at trước khi đặt NOT NULL (Q-10).
    Máy chuyển trạng thái (N-09), trigger BEFORE UPDATE OF status:
      booked    → confirmed | cancelled
      confirmed → arrived | no_show
      chờ Q-03: arrived → done (R-08, N-10 cần) · confirmed → cancelled (R-12, N-13 cần)
    Số lần khám đã hoàn thành của bệnh nhân (N-10) tính ra: COUNT(*) WHERE patient_id = ? AND status = 'done' — không lưu.
  '''
}

Table appointment_services {
  appointment_id uuid [not null, ref: > appointments.id]
  service_id uuid [not null, ref: > services.id]
  quantity smallint [not null, default: 1]
  unit_price numeric(12,2) [not null, note: 'Giá một đơn vị chép từ services.price lúc khám; hóa đơn in giá này, không đổi khi bảng giá đổi (N-01)']

  indexes {
    (appointment_id, service_id) [pk]
  }

  Note: '''
    Dịch vụ được thực hiện trong một lịch hẹn. Nguồn: R-07, N-01.
    🔴 A thời điểm chép giá: chép khi ghi dòng, chép lại khi lịch hẹn sang arrived; sau khi lập hóa đơn thì cố định (Q-09).
    CHECK (unit_price >= 0) · CHECK (quantity > 0)
  '''
}

Table invoices {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null, ref: > organizations.id]
  appointment_id uuid [not null]
  issued_at timestamptz [not null, default: `now()`]

  indexes {
    (organization_id, appointment_id) [unique, name: 'invoices_appointment_uq']
  }

  Note: '''
    Hóa đơn của một lịch hẹn; mỗi lịch hẹn tối đa một hóa đơn (R-08). Nguồn: R-08, N-12, N-13.
    Tra theo lịch hẹn: index invoices_appointment_uq. Tra theo bệnh nhân: appointments (patient_id, starts_at) rồi nối invoices_appointment_uq — không chép patient_id sang đây (N-12).
    Tổng tiền tính ra: SUM(quantity * unit_price) của appointment_services.
  '''
}

Table payments {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null, ref: > organizations.id]
  invoice_id uuid [not null]
  amount numeric(12,2) [not null]
  method payment_method [not null]
  paid_at timestamptz [not null, default: `now()`]

  indexes {
    (invoice_id)
  }

  Note: 'Một khoản thanh toán cho hóa đơn. Hoàn tiền là dòng mới mang số âm. Nguồn: R-08, N-13.'
}

// ---------------------------------------------------------------------
//  v1.1 — bảng mới
// ---------------------------------------------------------------------

Table guardianships {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null]
  guardian_person_id uuid [not null, note: 'Người bảo hộ — bất kỳ người nào trong people (bác sĩ, nhân viên, người nhà) (N-03)']
  ward_patient_id uuid [not null, note: 'Bệnh nhân được bảo hộ (N-03)']
  starts_on date [not null, note: 'Bảo hộ có hiệu lực từ ngày (N-03)']
  ends_on date [note: 'Ngày kết thúc bảo hộ; trống = đang hiệu lực']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (guardian_person_id)
    (ward_patient_id)
  }

  Note: '''
    Quan hệ bảo hộ: ai bảo hộ bệnh nhân nào, từ ngày nào (N-03). Kết thúc = đặt ends_on; dòng giữ lại làm lịch sử.
    CHECK (ends_on IS NULL OR ends_on >= starts_on)
    CREATE UNIQUE INDEX guardianships_active_uq ON guardianships (guardian_person_id, ward_patient_id) WHERE ends_on IS NULL;
    Trigger: guardian_person_id khác patients.person_id của ward_patient_id (không tự bảo hộ mình). Không ràng buộc tuổi vì people.birth_date có thể trống.
  '''
}

Table appointment_deposits {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null]
  appointment_id uuid [not null]
  amount numeric(12,2) [not null, note: 'Số tiền cọc: dương = nhận cọc, âm = hoàn cọc (dòng mới, không sửa dòng cũ) (N-05)']
  received_on date [not null, note: 'Ngày nhận cọc, hoặc ngày hoàn với dòng âm (N-05)']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (appointment_id)
  }

  Note: '''
    Khoản đặt cọc của một lịch hẹn (N-05). Mỗi lịch hẹn tối đa một khoản nhận cọc:
    CREATE UNIQUE INDEX appointment_deposits_one_uq ON appointment_deposits (appointment_id) WHERE amount > 0;
    CHECK (amount <> 0)
    Cọc khi hủy lịch (R-12) và khi lập hóa đơn: chờ Q-12 — chưa trừ vào hóa đơn, chưa vào báo cáo doanh thu (R-11).
  '''
}

Table internal_notes {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null]
  appointment_id uuid [note: 'Ghi chú gắn vào lịch hẹn; đúng một trong ba cột đích có giá trị (N-06)']
  patient_id uuid [note: 'Ghi chú gắn vào bệnh nhân (N-06)']
  invoice_id uuid [note: 'Ghi chú gắn vào hóa đơn (N-06)']
  author_user_id uuid [not null, note: 'Nhân viên viết ghi chú']
  body text [not null, note: 'Nội dung ghi chú nội bộ, không hiện cho bệnh nhân']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz [note: 'Ẩn ghi chú']

  indexes {
    (appointment_id)
    (patient_id)
    (invoice_id)
    (author_user_id)
  }

  Note: '''
    Ghi chú nội bộ gắn vào một lịch hẹn, một bệnh nhân hoặc một hóa đơn (N-06). Ba FK thật, không dùng cặp *_type + *_id.
    CHECK (num_nonnulls(appointment_id, patient_id, invoice_id) = 1)
    CHECK (length(body) BETWEEN 1 AND 4000)
    Quyền đọc theo R-10: lễ tân thấy ghi chú của dữ liệu phòng khám mình.
  '''
}

Table patient_allergies {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null]
  patient_id uuid [not null]
  substance varchar(120) [not null, note: 'Tên chất gây dị ứng, nhập tự do; tra không phân biệt hoa thường (N-07)']
  severity allergy_severity [not null, note: 'Mức độ dị ứng: nhẹ hay nặng (N-07)']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (patient_id, `lower(substance)`) [unique, name: 'patient_allergies_patient_substance_uq']
    (organization_id, `lower(substance)`) [name: 'patient_allergies_substance_idx']
  }

  Note: '''
    Dị ứng của bệnh nhân, mỗi chất một dòng (N-07). Lễ tân tra bệnh nhân theo chất qua patient_allergies_substance_idx.
    Dữ liệu sức khỏe: hạn lưu và quyền xem theo hồ sơ bệnh nhân — 🔴 A, Q-13.
  '''
}

Table specialties {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null]
  name varchar(120) [not null, note: 'Tên chuyên khoa, quản trị viên thêm trên màn hình quản trị (N-08)']
  is_active boolean [not null, default: true, note: 'Bớt chuyên khoa = tắt; dòng giữ lại để bác sĩ đã gắn không mất lịch sử']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (organization_id, `lower(name)`) [unique, name: 'specialties_org_name_uq']
  }

  Note: 'Danh mục chuyên khoa do quản trị viên quản lý (N-08). 🔴 A: bớt = tắt is_active, không xóa dòng.'
}

Table doctor_specialties {
  organization_id uuid [not null]
  doctor_id uuid [not null]
  specialty_id uuid [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (doctor_id, specialty_id) [pk]
    (specialty_id)
  }

  Note: 'Bác sĩ thuộc chuyên khoa nào; một bác sĩ nhiều chuyên khoa (N-08). Gỡ bác sĩ khỏi chuyên khoa = xóa dòng.'
}

Table patient_insurances {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null]
  patient_id uuid [not null, unique, note: 'Bệnh nhân sở hữu hồ sơ; UNIQUE = tối đa một hồ sơ bảo hiểm (N-15)']
  card_number varchar(30) [not null, note: 'Số thẻ bảo hiểm (N-15) — dữ liệu cá nhân']
  insurer_name varchar(160) [not null, note: 'Tên nhà bảo hiểm, nhập tự do (N-15)']
  valid_until date [not null, note: 'Hạn dùng của thẻ bảo hiểm (N-15)']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Hồ sơ bảo hiểm hiện hành của bệnh nhân (N-15). Đổi thẻ = sửa dòng, không giữ lịch sử thẻ cũ — 🔴 A, Q-13.'
}

// ---------------------------------------------------------------------
//  Khóa ngoại có hành vi xóa (v1.1)
// ---------------------------------------------------------------------

// N-13: ẩn bệnh nhân không xóa dòng; chặn xóa cứng để hóa đơn, thanh toán còn nguyên.
Ref appointments_patient: appointments.patient_id > patients.id [delete: restrict]
Ref invoices_appointment: invoices.appointment_id > appointments.id [delete: restrict]
Ref payments_invoice: payments.invoice_id > invoices.id [delete: restrict]

Ref guardianships_org: guardianships.organization_id > organizations.id [delete: restrict]
Ref guardianships_guardian: guardianships.guardian_person_id > people.id [delete: restrict]
Ref guardianships_ward: guardianships.ward_patient_id > patients.id [delete: restrict]

Ref appointment_deposits_org: appointment_deposits.organization_id > organizations.id [delete: restrict]
Ref appointment_deposits_appointment: appointment_deposits.appointment_id > appointments.id [delete: restrict]

Ref internal_notes_org: internal_notes.organization_id > organizations.id [delete: restrict]
Ref internal_notes_appointment: internal_notes.appointment_id > appointments.id [delete: restrict]
Ref internal_notes_patient: internal_notes.patient_id > patients.id [delete: restrict]
Ref internal_notes_invoice: internal_notes.invoice_id > invoices.id [delete: restrict]
Ref internal_notes_author: internal_notes.author_user_id > users.id [delete: restrict]

Ref patient_allergies_org: patient_allergies.organization_id > organizations.id [delete: restrict]
Ref patient_allergies_patient: patient_allergies.patient_id > patients.id [delete: cascade]

Ref specialties_org: specialties.organization_id > organizations.id [delete: restrict]
Ref doctor_specialties_org: doctor_specialties.organization_id > organizations.id [delete: restrict]
Ref doctor_specialties_doctor: doctor_specialties.doctor_id > doctors.id [delete: cascade]
Ref doctor_specialties_specialty: doctor_specialties.specialty_id > specialties.id [delete: restrict]

Ref patient_insurances_org: patient_insurances.organization_id > organizations.id [delete: restrict]
Ref patient_insurances_patient: patient_insurances.patient_id > patients.id [delete: cascade]
