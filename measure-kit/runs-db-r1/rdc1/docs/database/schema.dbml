// =====================================================================
//  Phòng khám đa khoa chuỗi — đặt lịch khám
//  v1.1 2026-10-07 — áp nhu cầu dữ liệu giai đoạn 2 (N-01 → N-20)
//  v1.0 2026-09-01 — schema đầu tiên của dự án mẫu (đề đo db-r1)
//  Nguồn: 1-yeu-cau/YEU-CAU-PHONG-KHAM.md (R-01 → R-12)
//         1-yeu-cau/NHU-CAU-DU-LIEU-MOI.md (N-01 → N-20)
//  Câu hỏi chờ BA: docs/database/CAU-HOI-BA.md (Q-03 →)
//
//  DBML không diễn đạt được: CHECK, EXCLUDE, unique một phần (WHERE).
//  Các ràng buộc đó ghi ở Note của bảng và có DDL ở
//  DATA-DICTIONARY.md mục 5 — đừng bỏ sót khi sinh migration.
// =====================================================================

Project clinic_chain {
  database_type: 'PostgreSQL'
  Note: '''
    Chuỗi phòng khám đa khoa, nhiều phòng khám thuộc một tổ chức (organization).
    Mọi bảng nghiệp vụ mang organization_id. Múi giờ lưu UTC.
    Cần extension btree_gist (ràng buộc không trùng lịch bác sĩ — N-02).
  '''
}

Enum user_role {
  admin
  receptionist
  doctor
}

// N-09. Giữ done từ v1.0: N-10 (lần khám hoàn thành) và R-08 (lịch hẹn đã khám) dựa vào nó.
// Chuyển trạng thái hợp lệ ĐÃ CHỐT: booked -> confirmed | cancelled ; confirmed -> arrived | no_show.
// CHƯA CHỐT (Q-05): arrived -> done ; confirmed -> cancelled ; trạng thái cuối.
Enum appointment_status {
  booked
  confirmed
  arrived
  done
  no_show
  cancelled
}

// N-13 · R-12. Phân biệt ai hủy để áp quy tắc phí hủy (R-12) đúng chỗ.
Enum appointment_cancel_reason {
  by_patient
  by_clinic
  patient_hidden
}

Enum payment_method {
  cash
  card
  transfer
}

// N-07
Enum allergy_severity {
  mild
  severe
}

Table organizations {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(160) [not null]
  created_at timestamptz [not null, default: `now()`]
}

Table clinics {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null, ref: > organizations.id]
  name varchar(160) [not null]
  address varchar(255)
  created_at timestamptz [not null, default: `now()`]

  Note: 'Một phòng khám (chi nhánh). Nguồn: R-01.'
}

Table people {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null, ref: > organizations.id]
  full_name varchar(160) [not null]
  phone varchar(20)
  email varchar(160)
  birth_date date
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    (organization_id, full_name)
  }

  Note: '''
    Một dòng = một con người. Danh tính nằm ở đây, vai ở các bảng patients, doctors, users. Nguồn: R-02.
    N-03: một người giữ nhiều vai cùng lúc (lễ tân kiêm bệnh nhân, bác sĩ kiêm người bảo hộ) — không cần sửa bảng này.
    Giá trị suy ra, KHÔNG lưu: tuổi / "là trẻ nhỏ" — tính từ birth_date.
  '''
}

Table patients {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null, ref: > organizations.id]
  person_id uuid [not null, unique, ref: - people.id]
  record_code varchar(32) [not null, note: 'N-04. Mã hồ sơ, duy nhất trong tổ chức CHỈ trong số hồ sơ chưa ẩn (deleted_at IS NULL). Định dạng + cách sinh: Q-07.']
  created_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  Note: '''
    Hồ sơ bệnh nhân. Một người tối đa một hồ sơ bệnh nhân. Nguồn: R-02, R-03.
    N-04 — unique MỘT PHẦN: CREATE UNIQUE INDEX ux_patients_org_record_code_live ON patients (organization_id, record_code) WHERE deleted_at IS NULL. Cố ý KHÔNG khai trong indexes {}: DBML không có WHERE — khai unique sẽ sinh unique toàn bảng (chặn cấp lại mã), khai thường sẽ sinh một chỉ mục trùng tên với chỉ mục thật. DDL ở DATA-DICTIONARY mục 5.2.
    N-04 · N-13: "ẩn" = đặt deleted_at trên bảng NÀY, không đụng people.deleted_at (người đó có thể còn là bác sĩ hay lễ tân — N-03). Không xóa cứng: mọi FK trỏ vào patients là NO ACTION nên xóa cứng bị chặn khi còn lịch hẹn / hóa đơn / thanh toán.
    Giá trị suy ra, KHÔNG lưu: tổng số lần khám hoàn thành (N-10) = COUNT appointments status = done; số buổi điều trị còn lại (N-18, chờ Q-04).
  '''
}

Table doctors {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null, ref: > organizations.id]
  person_id uuid [not null, unique, ref: - people.id]
  clinic_id uuid [not null, ref: > clinics.id]
  created_at timestamptz [not null, default: `now()`]

  Note: 'Hồ sơ bác sĩ; mỗi bác sĩ thuộc một phòng khám chính. Nguồn: R-02, R-05. Chuyên khoa: bảng doctor_specialties (N-08).'
}

Table users {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null, ref: > organizations.id]
  person_id uuid [not null, ref: > people.id]
  role user_role [not null]
  login_email varchar(160) [not null]
  password_hash varchar(255) [not null]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (organization_id, login_email) [unique]
  }

  Note: 'Tài khoản đăng nhập. Một người có thể có nhiều tài khoản, mỗi vai một dòng. Nguồn: R-09. Mật khẩu chỉ lưu băm — N-14 (lưu mật khẩu đọc được) KHÔNG áp dụng, xem Q-06.'
}

Table rooms {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null, ref: > organizations.id]
  clinic_id uuid [not null, ref: > clinics.id]
  name varchar(80) [not null]

  indexes {
    (clinic_id, name) [unique]
  }

  Note: 'Phòng khám bệnh trong một phòng khám. Nguồn: R-06. Phòng mổ / phẫu thuật (N-17): chưa mô hình hóa, chờ Q-09.'
}

Table services {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null, ref: > organizations.id]
  code varchar(40) [not null, note: 'N-11. Mã dịch vụ, ví dụ KHAM-TQ. Duy nhất trong tổ chức.']
  name varchar(160) [not null]
  price numeric(12,2) [not null]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (organization_id, code) [unique]
  }

  Note: '''
    Danh mục dịch vụ và giá HIỆN HÀNH. Nguồn: R-07.
    N-01: giá ở đây chỉ để tra khi lập hóa đơn; hóa đơn đã lập đọc giá từ invoice_items, không đọc lại cột này.
    N-11: hai tổ chức khác nhau dùng cùng một mã được vì unique là (organization_id, code).
  '''
}

// N-08. Danh mục chuyên khoa do quản trị viên thêm / bớt lúc chạy -> là dữ liệu, KHÔNG phải Enum.
Table specialties {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null, ref: > organizations.id]
  name varchar(120) [not null]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (organization_id, name) [unique]
  }

  Note: 'Danh mục chuyên khoa. "Bớt" = is_active = false (giữ lịch sử gán cho bác sĩ), không xóa cứng. Nguồn: N-08.'
}

Table doctor_specialties {
  doctor_id uuid [not null, ref: > doctors.id]
  specialty_id uuid [not null, ref: > specialties.id]
  organization_id uuid [not null, ref: > organizations.id]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (doctor_id, specialty_id) [pk]
    (specialty_id)
  }

  Note: 'Bác sĩ — chuyên khoa (nhiều-nhiều). Nguồn: N-08. doctor và specialty phải cùng organization_id: kiểm ở tầng ứng dụng / trigger.'
}

Table doctor_schedules {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null, ref: > organizations.id]
  doctor_id uuid [not null, ref: > doctors.id]
  weekday smallint [not null, note: '1 = thứ hai … 7 = chủ nhật']
  start_time time [not null]
  end_time time [not null]

  indexes {
    (doctor_id, weekday)
  }

  Note: 'Ca làm việc cố định hằng tuần của bác sĩ. Nguồn: R-05.'
}

Table appointments {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null, ref: > organizations.id]
  clinic_id uuid [not null, ref: > clinics.id]
  patient_id uuid [not null, ref: > patients.id]
  doctor_id uuid [not null, ref: > doctors.id]
  starts_at timestamptz [not null]
  ends_at timestamptz [not null, note: 'N-02. Giờ kết thúc. Khoảng thời gian là nửa mở [starts_at, ends_at) nên hai ca liền kề (ca này kết thúc đúng giờ ca kia bắt đầu) không bị coi là trùng.']
  status appointment_status [not null, default: 'booked']
  deposit_amount numeric(12,2) [note: 'N-05. Tiền đặt cọc; NULL = không có cọc. Có giá trị thì phải > 0 và đi kèm deposit_received_on.']
  deposit_received_on date [note: 'N-05. Ngày nhận cọc.']
  cancelled_at timestamptz [note: 'N-13 · R-12. Thời điểm hủy; chỉ có giá trị khi status = cancelled (lịch hủy từ trước v1.1 để trống). R-12 so cancelled_at với starts_at - 2 giờ.']
  cancel_reason appointment_cancel_reason [note: 'N-13. Ai hủy; chỉ có giá trị khi status = cancelled, cùng NULL / cùng có với cancelled_at. patient_hidden = hệ thống tự hủy khi ẩn bệnh nhân (không thuộc phí hủy của R-12 — chờ Q-08).']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (organization_id, clinic_id, starts_at)
    (patient_id, starts_at)
  }

  Note: '''
    Lịch hẹn khám. Mỗi lịch hẹn có đúng một bác sĩ phụ trách (R-04). Nguồn: R-03, R-04.
    N-02 — KHÔNG trùng lịch bác sĩ: EXCLUDE USING gist (doctor_id WITH =, tstzrange(starts_at, ends_at, '[)') WITH &&) WHERE status IN (booked, confirmed, arrived, done). Lịch hủy / vắng mặt không giữ chỗ. Cần btree_gist. DBML không diễn đạt EXCLUDE — DDL ở DATA-DICTIONARY mục 5.
    CHECK: ends_at > starts_at; deposit_amount IS NULL hoặc > 0; deposit_amount và deposit_received_on cùng NULL hoặc cùng có; cancelled_at và cancel_reason cùng NULL hoặc cùng có, và chỉ có khi status = cancelled (lịch hủy cũ được phép trống cả hai).
    N-16 (nhiều bác sĩ một lịch hẹn) mâu thuẫn R-04 và đang chờ Q-03 — doctor_id giữ nguyên là một bác sĩ.
    N-19: KHÔNG tách bảng theo chi nhánh. Báo cáo từng chi nhánh dùng chỉ mục (organization_id, clinic_id, starts_at) ở trên.
    Giá trị suy ra, KHÔNG lưu: thời lượng = ends_at - starts_at.
  '''
}

Table appointment_services {
  appointment_id uuid [not null, ref: > appointments.id]
  service_id uuid [not null, ref: > services.id]
  quantity smallint [not null, default: 1]

  indexes {
    (appointment_id, service_id) [pk]
  }

  Note: 'Dịch vụ được thực hiện trong một lịch hẹn. Nguồn: R-07. KHÔNG mang giá: giá lúc khám được chụp vào invoice_items khi lập hóa đơn (N-01).'
}

Table invoices {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null, ref: > organizations.id]
  appointment_id uuid [not null, ref: > appointments.id]
  issued_at timestamptz [not null, default: `now()`]

  indexes {
    appointment_id [unique, name: 'ux_invoices_appointment']
  }

  Note: '''
    Hóa đơn của một lịch hẹn. Nguồn: R-08. Dòng hàng và giá lúc khám ở invoice_items (N-01).
    N-12: tra theo lịch hẹn dùng ux_invoices_appointment (unique vì "mỗi lịch hẹn đã khám có MỘT hóa đơn" — R-08). Tra theo bệnh nhân: appointments(patient_id, starts_at) rồi invoices(appointment_id) — hai bước đều có chỉ mục, không chép patient_id sang đây để tránh lệch.
    Giá trị suy ra, KHÔNG lưu: tổng tiền = SUM(invoice_items.unit_price * quantity); đã thu = SUM(payments.amount).
  '''
}

// N-01. Ảnh chụp dòng hàng lúc lập hóa đơn: sau này bảng giá đổi, hóa đơn cũ vẫn in đúng.
Table invoice_items {
  invoice_id uuid [not null, ref: > invoices.id]
  service_id uuid [not null, ref: > services.id]
  organization_id uuid [not null, ref: > organizations.id]
  service_name varchar(160) [not null, note: 'Chụp tên dịch vụ lúc lập hóa đơn.']
  unit_price numeric(12,2) [not null, note: 'Chụp giá dịch vụ lúc lập hóa đơn. Không bao giờ cập nhật theo services.price.']
  quantity smallint [not null, default: 1]

  indexes {
    (invoice_id, service_id) [pk]
    (service_id)
  }

  Note: '''
    Dòng hóa đơn — SNAPSHOT giá lúc khám. Nguồn: N-01.
    Sinh ra bằng cách chép từ appointment_services + services tại thời điểm lập hóa đơn. Sau đó bất biến.
    Hóa đơn cũ (lập trước v1.1) không có dữ liệu giá thật; xem DATA-DICTIONARY mục 0 về cách chuyển dữ liệu.
  '''
}

Table payments {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null, ref: > organizations.id]
  invoice_id uuid [not null, ref: > invoices.id]
  amount numeric(12,2) [not null]
  method payment_method [not null]
  paid_at timestamptz [not null, default: `now()`]

  indexes {
    (invoice_id)
  }

  Note: 'Một khoản thanh toán cho hóa đơn. Hoàn tiền là dòng mới mang số âm. Nguồn: R-08. N-13: giữ nguyên khi ẩn bệnh nhân.'
}

// N-03
Table guardianships {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null, ref: > organizations.id]
  patient_id uuid [not null, ref: > patients.id, note: 'Người được bảo hộ (bệnh nhân).']
  guardian_person_id uuid [not null, ref: > people.id, note: 'Người bảo hộ — bất kỳ ai trong people: bác sĩ, lễ tân, người nhà.']
  starts_on date [not null, note: 'Bảo hộ từ ngày.']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (patient_id, guardian_person_id) [unique]
    (guardian_person_id)
  }

  Note: '''
    Quan hệ bảo hộ: ai bảo hộ bệnh nhân nào, từ ngày nào. Nguồn: N-03.
    Người bảo hộ trỏ về people (không phải doctors) vì người bảo hộ có thể là bác sĩ, lễ tân hoặc người ngoài.
    Ràng buộc ngoài DBML: guardian_person_id <> patients.person_id của patient_id (không tự bảo hộ chính mình) — tham chiếu chéo bảng nên dùng trigger / kiểm ứng dụng.
    Chưa có ngày kết thúc bảo hộ: chờ Q-10.
  '''
}

// N-06. Một ghi chú gắn vào đúng MỘT trong ba đối tượng; ba FK thật thay cho (target_type, target_id) không có khóa ngoại.
Table internal_notes {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null, ref: > organizations.id]
  appointment_id uuid [ref: > appointments.id]
  patient_id uuid [ref: > patients.id]
  invoice_id uuid [ref: > invoices.id]
  body text [not null]
  created_by uuid [not null, ref: > users.id]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (appointment_id)
    (patient_id)
    (invoice_id)
  }

  Note: '''
    Ghi chú nội bộ của nhân viên. Nguồn: N-06.
    CHECK: num_nonnulls(appointment_id, patient_id, invoice_id) = 1 — đúng một đối tượng.
    Ghi chú chỉ nhân viên thấy; không dùng để lưu dữ liệu y tế có cấu trúc (dị ứng ở patient_allergies).
  '''
}

// N-07
Table patient_allergies {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null, ref: > organizations.id]
  patient_id uuid [not null, ref: > patients.id]
  substance_name varchar(160) [not null, note: 'Tên chất gây dị ứng, nhập tự do.']
  severity allergy_severity [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (patient_id, `lower(substance_name)`) [unique, name: 'ux_patient_allergies_patient_substance']
    (organization_id, `lower(substance_name)`) [name: 'ix_patient_allergies_substance']
  }

  Note: '''
    Dị ứng của bệnh nhân — nhiều dòng cho một bệnh nhân. Nguồn: N-07.
    Tra bệnh nhân theo chất: ix_patient_allergies_substance (không phân biệt hoa thường). Chính tả khác nhau vẫn là chất khác — chấp nhận ở giai đoạn này (DATA-DICTIONARY mục 3).
  '''
}

// N-15. Quan hệ 0..1: tối đa một dòng cho một bệnh nhân (patient_id unique).
Table patient_insurances {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null, ref: > organizations.id]
  patient_id uuid [not null, unique, ref: - patients.id]
  card_number varchar(40) [not null]
  insurer_name varchar(160) [not null]
  expires_on date [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: '''
    Hồ sơ bảo hiểm: tối đa MỘT cho một bệnh nhân (0..1). Nguồn: N-15.
    Đổi thẻ = sửa dòng này tại chỗ, không thêm dòng. Không có thẻ = không có dòng.
    Giá trị suy ra, KHÔNG lưu: "thẻ còn hạn" = expires_on >= ngày khám.
  '''
}
