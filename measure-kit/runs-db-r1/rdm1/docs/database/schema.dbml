// =====================================================================
//  Phòng khám đa khoa chuỗi — đặt lịch khám
//  v1.0 2026-09-01 — schema hiện có của dự án mẫu (đề đo db-r1)
//  v1.1 2026-10-07 — áp nhu cầu dữ liệu giai đoạn 2 (N-01 → N-20); nhu cầu nào chưa dựng
//                    (N-14, N-16, N-17, N-18, N-20 chờ BA — Q-03 → Q-07; N-19 — Q-14) xem CAU-HOI-BA.md
//  Nguồn: 1-yeu-cau/YEU-CAU-PHONG-KHAM.md (R-01 → R-12) · 1-yeu-cau/NHU-CAU-DU-LIEU-MOI.md (N-01 → N-20)
// =====================================================================

Project clinic_chain {
  database_type: 'PostgreSQL'
  Note: '''
    Chuỗi phòng khám đa khoa, nhiều phòng khám thuộc một tổ chức (organization).
    Mọi bảng nghiệp vụ mang organization_id. Múi giờ lưu UTC.
    Giả định 🔴 A (B0, v1.1): PostgreSQL 14 trở lên; cần extension btree_gist cho EXCLUDE (N-02);
    cỡ dữ liệu theo Q-01 (khoảng 2.000 lịch hẹn mỗi ngày, tức khoảng 0,73 triệu mỗi năm).
    Quy ước bảng mới của v1.1: khóa ngoại tới bảng nghiệp vụ là khóa ghép (organization_id, …) để dòng của
    tổ chức này không trỏ được sang tổ chức khác (DB-INT-12); bảng cũ v1.0 giữ khóa ngoại đơn (nợ cũ).
    Câu hỏi cần BA chốt: docs/database/CAU-HOI-BA.md (Q-03 trở đi).
  '''
}

Enum user_role {
  admin
  receptionist
  doctor
}

Enum appointment_status {
  booked
  confirmed
  arrived
  done
  no_show
  cancelled
}

Enum allergy_severity {
  mild
  severe
}

Enum payment_method {
  cash
  card
  transfer
}

Table organizations {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(160) [not null]
  created_at timestamptz [not null, default: `now()`]

  Note: 'Tổ chức, đóng vai tenant: mọi bảng nghiệp vụ mang organization_id trỏ về đây. Nguồn: R-01.'
}

Table clinics {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null, ref: > organizations.id]
  name varchar(160) [not null]
  address varchar(255)
  created_at timestamptz [not null, default: `now()`]

  Note: 'Một phòng khám (chi nhánh). Nguồn: R-01.'
}

Table people {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null, ref: > organizations.id]
  full_name varchar(160) [not null]
  phone varchar(20)
  email varchar(160)
  birth_date date
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    (organization_id, full_name)
    (organization_id, id) [unique, name: 'uq_people__organization_id__id']
  }

  Note: '''
    Một dòng = một con người. Danh tính nằm ở đây, vai ở các bảng patients, doctors, users. Nguồn: R-02.
    Một người có thể mang nhiều vai cùng lúc, ví dụ lễ tân đồng thời là bệnh nhân, bác sĩ đồng thời là người bảo hộ (N-03):
    không cần bảng hay cột mới cho phần này, vai nằm ở các bảng vai.
    Unique (organization_id, id) là đích cho khóa ngoại ghép của bảng mới (DB-INT-12).
  '''
}

Table patients {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null, ref: > organizations.id]
  person_id uuid [not null, unique, ref: - people.id]
  record_code varchar(32) [not null, note: 'Mã hồ sơ, duy nhất trong tổ chức trong số hồ sơ chưa ẩn (N-04); mã của hồ sơ đã ẩn được cấp lại']
  created_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz [note: 'Thời điểm ẩn hồ sơ (N-04, N-13); ẩn không làm mất hóa đơn và thanh toán']

  indexes {
    (organization_id, id) [unique, name: 'uq_patients__organization_id__id']
  }

  Note: '''
    Hồ sơ bệnh nhân. Một người tối đa một hồ sơ bệnh nhân. Nguồn: R-02, R-03, N-04, N-10, N-13.
    UNIQUE (một phần): CREATE UNIQUE INDEX uq_patients__record_code ON patients (organization_id, lower(record_code)) WHERE deleted_at IS NULL
    Quyết định khó đảo ngược (N-04): unique chỉ tính hồ sơ chưa ẩn, nên cùng một mã có thể nằm ở một hồ sơ ẩn và một hồ sơ đang dùng.
    Mọi truy vấn tìm theo mã phải lọc deleted_at IS NULL; khôi phục hồ sơ ẩn có thể đụng mã đã cấp lại (Q-11).
    Cố ý không lưu: tổng số lần khám đã hoàn thành (N-10) = số dòng appointments của bệnh nhân có status = 'done'; xem DATA-DICTIONARY mục 4.
    Cố ý không lưu: số buổi điều trị còn lại (N-18, CHẶN — Q-06).
    Ẩn hồ sơ (N-13): chỉ đặt deleted_at; hóa đơn và thanh toán giữ nguyên vì khóa ngoại dọc chuỗi appointments → invoices → payments đều restrict.
  '''
}

Table doctors {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null, ref: > organizations.id]
  person_id uuid [not null, unique, ref: - people.id]
  clinic_id uuid [not null, ref: > clinics.id]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (organization_id, id) [unique, name: 'uq_doctors__organization_id__id']
  }

  Note: 'Hồ sơ bác sĩ; mỗi bác sĩ thuộc một phòng khám chính. Nguồn: R-02, R-05. Chuyên khoa của bác sĩ ở doctor_specialties (N-08).'
}

Table users {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null, ref: > organizations.id]
  person_id uuid [not null, ref: > people.id]
  role user_role [not null]
  login_email varchar(160) [not null]
  password_hash varchar(255) [not null]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (organization_id, login_email) [unique]
    (organization_id, id) [unique, name: 'uq_users__organization_id__id']
  }

  Note: '''
    Tài khoản đăng nhập. Một người có thể có nhiều tài khoản, mỗi vai một dòng. Nguồn: R-09.
    Mật khẩu chỉ lưu băm (password_hash). N-14 đòi lưu mật khẩu đọc được: không làm, đang chờ BA (Q-03).
  '''
}

Table rooms {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null, ref: > organizations.id]
  clinic_id uuid [not null, ref: > clinics.id]
  name varchar(80) [not null]

  indexes {
    (clinic_id, name) [unique]
  }

  Note: 'Phòng khám bệnh trong một phòng khám. Nguồn: R-06.'
}

Table services {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null, ref: > organizations.id]
  code varchar(40) [not null, note: 'Mã dịch vụ, ví dụ KHAM-TQ; duy nhất trong tổ chức, không phân biệt hoa thường (N-11)']
  name varchar(160) [not null]
  price numeric(12,2) [not null, note: 'Giá hiện hành. Giá đã tính cho từng lịch hẹn nằm ở appointment_services.unit_price (N-01)']
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (organization_id, `lower(code)`) [unique, name: 'uq_services__organization_id__code']
  }

  Note: 'Danh mục dịch vụ và giá hiện hành. Nguồn: R-07, N-11. Hai tổ chức khác nhau dùng cùng một mã được vì unique có organization_id dẫn đầu.'
}

Table doctor_schedules {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null, ref: > organizations.id]
  doctor_id uuid [not null, ref: > doctors.id]
  weekday smallint [not null, note: '1 = thứ hai … 7 = chủ nhật']
  start_time time [not null]
  end_time time [not null]

  indexes {
    (doctor_id, weekday)
  }

  Note: 'Ca làm việc cố định hằng tuần của bác sĩ. Nguồn: R-05.'
}

Table appointments {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null, ref: > organizations.id]
  clinic_id uuid [not null, ref: > clinics.id]
  patient_id uuid [not null]
  doctor_id uuid [not null, ref: > doctors.id]
  starts_at timestamptz [not null]
  ends_at timestamptz [not null, note: 'Giờ kết thúc (N-02). Khoảng nửa mở [starts_at, ends_at): 09:00–09:30 và 09:30–10:00 không trùng']
  status appointment_status [not null, default: 'booked', note: 'Máy trạng thái ở Note của bảng (N-09)']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (organization_id, clinic_id, starts_at)
    (patient_id, starts_at)
    (organization_id, id) [unique, name: 'uq_appointments__organization_id__id']
  }

  Note: '''
    Lịch hẹn khám. Mỗi lịch hẹn có đúng một bác sĩ phụ trách (R-04). Nguồn: R-03, R-04, N-02, N-09, N-10, N-12, N-13, N-19.
    N-16 đòi từ hai bác sĩ trở lên trên một lịch hẹn: mâu thuẫn R-04, CHẶN chờ BA (Q-04); đến lúc đó doctor_id vẫn là bác sĩ duy nhất.
    CHECK: CHECK (ends_at > starts_at)
    EXCLUDE: EXCLUDE USING gist (doctor_id WITH =, tstzrange(starts_at, ends_at) WITH &&) WHERE (status NOT IN ('cancelled', 'no_show')) -- cần btree_gist (N-02); trạng thái nào còn chiếm giờ là giả định 🔴 A (Q-09)
    Máy trạng thái (DB-MOD-10, N-09): booked → confirmed | cancelled; confirmed → arrived | no_show. Giả định 🔴 A: arrived → done (Q-08).
    Chưa nêu trong N-09 nhưng N-13 cần: hủy tự động từ confirmed (Q-08). Cưỡng chế ở ứng dụng bằng UPDATE … WHERE id = ? AND status = <trạng thái gốc>, không dùng trigger.
    Báo cáo từng chi nhánh (N-19) đọc từ index (organization_id, clinic_id, starts_at), không tách bảng theo chi nhánh (Q-14).
    Tra hóa đơn theo bệnh nhân (N-12): đi qua index (patient_id, starts_at) rồi invoices.appointment_id unique, không thêm patient_id vào invoices.
  '''
}

Table appointment_services {
  appointment_id uuid [not null, ref: > appointments.id]
  service_id uuid [not null, ref: > services.id]
  quantity smallint [not null, default: 1]
  unit_price numeric(12,2) [not null, check: `unit_price >= 0`, note: 'Giá một đơn vị tại thời điểm khám, chép từ services.price lúc ghi dòng (N-01); hóa đơn in giá này']

  indexes {
    (appointment_id, service_id) [pk]
  }

  Note: '''
    Dịch vụ được thực hiện trong một lịch hẹn. Nguồn: R-07, N-01.
    Snapshot có chủ đích (DB-MOD-08): đổi services.price sau đó không làm đổi hóa đơn cũ. Tổng tiền hóa đơn = tổng quantity × unit_price của các dòng.
    TRIGGER (khuyến nghị, Q-10): chặn UPDATE/DELETE dòng khi lịch hẹn đã có hóa đơn, để hóa đơn không đổi sau khi phát hành.
    Chốt giá lúc đặt lịch hay lúc khám: Q-10.
  '''
}

Table invoices {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null, ref: > organizations.id]
  appointment_id uuid [not null, unique]
  issued_at timestamptz [not null, default: `now()`]

  indexes {
    (organization_id, id) [unique, name: 'uq_invoices__organization_id__id']
  }

  Note: '''
    Hóa đơn của một lịch hẹn. Nguồn: R-08, N-12, N-13.
    appointment_id unique: mỗi lịch hẹn đã khám có đúng một hóa đơn (R-08), đồng thời là index tra hóa đơn theo lịch hẹn (N-12). v1.0 chưa khai unique này.
    Hóa đơn của bệnh nhân đã ẩn vẫn còn (N-13): khóa ngoại tới appointments là restrict; truy vấn kế toán không lọc patients.deleted_at.
  '''
}

Table payments {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null, ref: > organizations.id]
  invoice_id uuid [not null]
  amount numeric(12,2) [not null]
  method payment_method [not null]
  paid_at timestamptz [not null, default: `now()`]

  indexes {
    (invoice_id)
  }

  Note: 'Một khoản thanh toán cho hóa đơn. Hoàn tiền là dòng mới mang số âm. Nguồn: R-08, N-13 (thanh toán của bệnh nhân đã ẩn vẫn còn: khóa ngoại tới invoices là restrict).'
}

// ---------------------------------------------------------------------
//  Khóa ngoại của bảng cũ được chuyển sang Ref rời để khai hành vi xóa (N-13)
// ---------------------------------------------------------------------

Ref fk_appointments__patient_id: appointments.patient_id > patients.id [delete: restrict]
Ref fk_invoices__appointment_id: invoices.appointment_id > appointments.id [delete: restrict]
Ref fk_payments__invoice_id: payments.invoice_id > invoices.id [delete: restrict]

// ---------------------------------------------------------------------
//  v1.1 — bảng mới của nhu cầu giai đoạn 2
// ---------------------------------------------------------------------

Table appointment_deposits {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null]
  appointment_id uuid [not null]
  amount numeric(12,2) [not null, check: `amount > 0`, note: 'Số tiền cọc, đồng']
  received_on date [not null, note: 'Ngày nhận cọc, theo ngày địa phương của phòng khám']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (organization_id, appointment_id) [unique, name: 'uq_appointment_deposits__organization_id__appointment_id']
  }

  Note: '''
    Khoản đặt cọc của một lịch hẹn, tối đa một khoản mỗi lịch hẹn (N-05). Nguồn: N-05.
    Tách bảng riêng vì chỉ thiểu số lịch hẹn có cọc (DB-MOD-04) và đây là tiền (DB-MOD-11): dòng này chỉ ghi nhận lúc nhận cọc, không sửa sau đó.
    Cố ý chưa có: cách trừ cọc vào hóa đơn, hoàn cọc khi hủy, phương thức nhận cọc — chờ chính sách (Q-13); khi có, hoàn hay trừ cọc là dòng sổ cái mới ở chỗ khác, vì unique ở đây chỉ cho một khoản mỗi lịch hẹn.
    Không đưa cọc vào payments vì payments.invoice_id bắt buộc mà lúc nhận cọc chưa có hóa đơn.
  '''
}

Table guardianships {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null]
  patient_id uuid [not null, note: 'Bệnh nhân được bảo hộ']
  guardian_person_id uuid [not null, note: 'Người bảo hộ; là một người (people) nên có thể là bác sĩ, lễ tân hoặc bệnh nhân khác']
  started_on date [not null, note: 'Bảo hộ từ ngày (N-03)']
  ended_on date [note: 'Ngày kết thúc bảo hộ; giả định 🔴 A, N-03 chỉ nêu ngày bắt đầu (Q-15)']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (organization_id, patient_id, guardian_person_id, started_on) [unique, name: 'uq_guardianships__patient_guardian_started']
    (organization_id, guardian_person_id)
  }

  Note: '''
    Quan hệ bảo hộ: ai bảo hộ bệnh nhân nào, từ ngày nào (N-03). Nguồn: N-03.
    CHECK: CHECK (ended_on IS NULL OR ended_on >= started_on)
    Không cưỡng chế ở CSDL (không có rule nguồn): hai giai đoạn bảo hộ chồng nhau của cùng một cặp; người bảo hộ trùng danh tính với chính bệnh nhân; bệnh nhân phải nhỏ tuổi.
    Danh tính tách khỏi vai (DB-MOD-01): người bảo hộ trỏ people, không trỏ doctors hay users.
  '''
}

Table internal_notes {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null]
  appointment_id uuid [note: 'Đích thứ nhất; đúng một trong ba đích có giá trị']
  patient_id uuid [note: 'Đích thứ hai']
  invoice_id uuid [note: 'Đích thứ ba']
  body text [not null, note: 'Nội dung ghi chú nội bộ. Nhạy cảm: có thể chứa thông tin sức khỏe (DB-SEC-01)']
  created_by uuid [not null, note: 'Tài khoản nhân viên ghi chú']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (organization_id, appointment_id)
    (organization_id, patient_id, created_at)
    (organization_id, invoice_id)
    (organization_id, created_by)
  }

  Note: '''
    Ghi chú nội bộ gắn vào một lịch hẹn, một bệnh nhân hoặc một hóa đơn (N-06). Nguồn: N-06.
    Exclusive arc thay vì entity_type + entity_id (DB-MOD-06): mỗi đích là khóa ngoại thật.
    CHECK: CHECK (num_nonnulls(appointment_id, patient_id, invoice_id) = 1)
    Ba index đích có thể là index một phần WHERE cột IS NOT NULL để nhỏ hơn (DB-IDX-05); giữ index thường cho đến khi đo.
    Giả định 🔴 A: ghi chú chỉ thêm, chưa có sửa hay xóa nên chưa có updated_at.
  '''
}

Table allergens {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null]
  name varchar(120) [not null, note: 'Tên chất gây dị ứng, ví dụ Penicillin; duy nhất trong tổ chức, không phân biệt hoa thường']
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (organization_id, `lower(name)`) [unique, name: 'uq_allergens__organization_id__name']
    (organization_id, id) [unique, name: 'uq_allergens__organization_id__id']
  }

  Note: '''
    Danh mục chất gây dị ứng của tổ chức (N-07). Nguồn: N-07.
    Có danh mục thay vì chữ tự do để "tra bệnh nhân theo từng chất" không vỡ vì gõ khác nhau (Penicillin, penicilin). Ai thêm chất và có gộp chất trùng không: Q-16.
  '''
}

Table patient_allergies {
  organization_id uuid [not null]
  patient_id uuid [not null]
  allergen_id uuid [not null]
  severity allergy_severity [not null, note: 'Mức độ nhẹ hoặc nặng (N-07). Nhạy cảm: dữ liệu sức khỏe']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (organization_id, patient_id, allergen_id) [pk]
    (organization_id, allergen_id, patient_id)
  }

  Note: '''
    Dị ứng của bệnh nhân: nhiều dị ứng mỗi bệnh nhân, mỗi chất một dòng (N-07). Nguồn: N-07.
    Index (organization_id, allergen_id, patient_id) trả lời "bệnh nhân nào dị ứng chất này" (AP-03).
    Dị ứng là dữ liệu sức khỏe: ai được xem và có ghi log truy cập không là việc của lớp quyền, chưa có nguồn nêu (DB-SEC-05).
  '''
}

Table specialties {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null]
  name varchar(120) [not null, note: 'Tên chuyên khoa; duy nhất trong tổ chức, không phân biệt hoa thường']
  is_active boolean [not null, default: true, note: 'Bớt chuyên khoa = đặt false; chuyên khoa còn bác sĩ gắn thì không xóa dòng được']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (organization_id, `lower(name)`) [unique, name: 'uq_specialties__organization_id__name']
    (organization_id, id) [unique, name: 'uq_specialties__organization_id__id']
  }

  Note: '''
    Danh mục chuyên khoa do quản trị viên tự thêm hoặc bớt (N-08). Nguồn: N-08.
    Bảng tra cứu thay vì enum (DB-MOD-15): thêm chuyên khoa không sinh hành vi mới trong mã. Quyền thêm bớt thuộc vai admin, kiểm ở ứng dụng.
  '''
}

Table doctor_specialties {
  organization_id uuid [not null]
  doctor_id uuid [not null]
  specialty_id uuid [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (organization_id, doctor_id, specialty_id) [pk]
    (organization_id, specialty_id, doctor_id)
  }

  Note: 'Bác sĩ thuộc nhiều chuyên khoa, một chuyên khoa có nhiều bác sĩ (N-08). Nguồn: N-08. Bảng nối thuần, xóa cứng theo bác sĩ.'
}

Table patient_insurances {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null]
  patient_id uuid [not null]
  insurer_name varchar(160) [not null, note: 'Tên nhà bảo hiểm, chữ tự do (chưa có danh mục)']
  insurance_number varchar(40) [not null, note: 'Số thẻ bảo hiểm y tế. Nhạy cảm: định danh gắn với sức khỏe. Không phải số thẻ thanh toán nên không thuộc phạm vi PCI; đặt tên insurance_number để khỏi lẫn']
  valid_until date [not null, note: 'Hạn dùng của thẻ']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (organization_id, patient_id) [unique, name: 'uq_patient_insurances__organization_id__patient_id']
  }

  Note: '''
    Hồ sơ bảo hiểm của bệnh nhân, tối đa một mỗi bệnh nhân (N-15). Nguồn: N-15.
    Giả định 🔴 A: cả ba trường đều bắt buộc; đổi thẻ là sửa tại chỗ, không giữ lịch sử thẻ cũ (hóa đơn chưa nêu cần biết thẻ nào đã dùng).
    Nếu sau này một bệnh nhân có nhiều thẻ: bỏ unique, thêm cột hiệu lực; chưa làm vì N-15 nói tối đa một.
  '''
}

// Khóa ngoại ghép giữ cùng tổ chức (DB-INT-12); hành vi xóa theo chủ sở hữu (DB-INT-05)

Ref fk_appointment_deposits__organization: appointment_deposits.organization_id > organizations.id [delete: restrict]
Ref fk_appointment_deposits__appointment: appointment_deposits.(organization_id, appointment_id) > appointments.(organization_id, id) [delete: restrict]

Ref fk_guardianships__organization: guardianships.organization_id > organizations.id [delete: restrict]
Ref fk_guardianships__patient: guardianships.(organization_id, patient_id) > patients.(organization_id, id) [delete: cascade]
Ref fk_guardianships__guardian: guardianships.(organization_id, guardian_person_id) > people.(organization_id, id) [delete: restrict]

Ref fk_internal_notes__organization: internal_notes.organization_id > organizations.id [delete: restrict]
Ref fk_internal_notes__appointment: internal_notes.(organization_id, appointment_id) > appointments.(organization_id, id) [delete: cascade]
Ref fk_internal_notes__patient: internal_notes.(organization_id, patient_id) > patients.(organization_id, id) [delete: cascade]
Ref fk_internal_notes__invoice: internal_notes.(organization_id, invoice_id) > invoices.(organization_id, id) [delete: cascade]
Ref fk_internal_notes__created_by: internal_notes.(organization_id, created_by) > users.(organization_id, id) [delete: restrict]

Ref fk_allergens__organization: allergens.organization_id > organizations.id [delete: restrict]

Ref fk_patient_allergies__organization: patient_allergies.organization_id > organizations.id [delete: restrict]
Ref fk_patient_allergies__patient: patient_allergies.(organization_id, patient_id) > patients.(organization_id, id) [delete: cascade]
Ref fk_patient_allergies__allergen: patient_allergies.(organization_id, allergen_id) > allergens.(organization_id, id) [delete: restrict]

Ref fk_specialties__organization: specialties.organization_id > organizations.id [delete: restrict]

Ref fk_doctor_specialties__organization: doctor_specialties.organization_id > organizations.id [delete: restrict]
Ref fk_doctor_specialties__doctor: doctor_specialties.(organization_id, doctor_id) > doctors.(organization_id, id) [delete: cascade]
Ref fk_doctor_specialties__specialty: doctor_specialties.(organization_id, specialty_id) > specialties.(organization_id, id) [delete: restrict]

Ref fk_patient_insurances__organization: patient_insurances.organization_id > organizations.id [delete: restrict]
Ref fk_patient_insurances__patient: patient_insurances.(organization_id, patient_id) > patients.(organization_id, id) [delete: cascade]
