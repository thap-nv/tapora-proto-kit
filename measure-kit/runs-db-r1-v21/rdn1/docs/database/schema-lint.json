{
  "dialect": "postgresql",
  "tenant_column": "organization_id",
  "global_tables": ["organizations"],
  "audit_fk_suffixes": ["_by"],
  "default_on_delete": "restrict",
  "volumes": {
    "organizations": "S",
    "clinics": "S",
    "people": "M",
    "patients": "M",
    "doctors": "S",
    "users": "S",
    "rooms": "S",
    "services": "S",
    "doctor_schedules": "S",
    "appointments": "M",
    "appointment_services": "M",
    "invoices": "M",
    "invoice_lines": "M",
    "payments": "M",
    "appointment_deposits": "M",
    "patient_guardianships": "S",
    "internal_notes": "M",
    "patient_allergies": "M",
    "specialties": "S",
    "doctor_specialties": "S",
    "patient_insurances": "M"
  },
  "access_patterns": [
    { "id": "AP-01", "desc": "Hóa đơn của một lịch hẹn", "source": "N-12",
      "table": "invoices", "eq": ["appointment_id"], "sort": [], "range": [], "freq": "hot" },
    { "id": "AP-02", "desc": "Lịch hẹn của một bệnh nhân, mới nhất trước (bước đầu của tra hóa đơn theo bệnh nhân)", "source": "N-12",
      "table": "appointments", "eq": ["patient_id"], "sort": ["starts_at desc"], "range": [], "freq": "hot" },
    { "id": "AP-03", "desc": "Lịch của một bác sĩ trong một ngày", "source": "N-02",
      "table": "appointments", "eq": ["doctor_id"], "sort": [], "range": ["starts_at"], "freq": "hot" },
    { "id": "AP-04", "desc": "Lịch hẹn của một phòng khám trong một ngày (báo cáo từng chi nhánh)", "source": "N-19",
      "table": "appointments", "eq": ["organization_id", "clinic_id"], "sort": [], "range": ["starts_at"], "freq": "hot" },
    { "id": "AP-05", "desc": "Bệnh nhân theo chất gây dị ứng", "source": "N-07",
      "table": "patient_allergies", "eq": ["organization_id", "`lower(substance)`"], "sort": [], "range": [], "freq": "normal" },
    { "id": "AP-06", "desc": "Ghi chú nội bộ của một bệnh nhân, mới nhất trước", "source": "N-06",
      "table": "internal_notes", "eq": ["patient_id"], "sort": ["created_at desc"], "range": [], "freq": "normal" }
  ],
  "waivers": [],
  "requirement_code_pattern": "R-\\d+|N-\\d+"
}
