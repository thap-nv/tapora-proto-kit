// =====================================================================
//  Phòng khám đa khoa chuỗi — đặt lịch khám
//  v1.1 2026-10-07 — áp 20 nhu cầu giai đoạn 2 (N-01 → N-20)
//  v1.0 2026-09-01 — schema hiện có của dự án mẫu (đề đo db-r1)
//  Nguồn: 1-yeu-cau/YEU-CAU-PHONG-KHAM.md (R-01 → R-12)
//         1-yeu-cau/NHU-CAU-DU-LIEU-MOI.md (N-01 → N-20)
//  Điểm cần BA chốt: docs/database/CAU-HOI-BA.md (Q-03 → Q-15)
//  Cú pháp DBML không diễn đạt được: ràng buộc loại trừ (EXCLUDE), CHECK,
//  chỉ mục một phần (partial index) — các ràng buộc đó viết bằng SQL
//  trong Note của bảng và ở DATA-DICTIONARY.md mục 5.
// =====================================================================

Project clinic_chain {
  database_type: 'PostgreSQL'
  Note: '''
    Chuỗi phòng khám đa khoa, nhiều phòng khám thuộc một tổ chức (organization).
    Mọi bảng nghiệp vụ mang organization_id. Múi giờ lưu UTC.
  '''
}

Enum user_role {
  admin
  receptionist
  doctor
}

Enum appointment_status {
  booked [note: 'Đã đặt — trạng thái đầu']
  confirmed [note: 'Đã xác nhận — N-09']
  arrived [note: 'Đã đến — N-09']
  no_show [note: 'Vắng mặt — N-09']
  cancelled [note: 'Đã hủy']
  done [note: 'Đã khám xong — giữ từ v1.0 vì R-08 và N-10 cần; quan hệ với arrived chờ Q-08']
}

Enum allergy_severity {
  mild [note: 'Nhẹ — N-07']
  severe [note: 'Nặng — N-07']
}

Enum payment_method {
  cash
  card
  transfer
}

Table organizations {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(160) [not null]
  created_at timestamptz [not null, default: `now()`]
}

Table clinics {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null, ref: > organizations.id]
  name varchar(160) [not null]
  address varchar(255)
  created_at timestamptz [not null, default: `now()`]

  Note: 'Một phòng khám (chi nhánh). Nguồn: R-01.'
}

Table people {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null, ref: > organizations.id]
  full_name varchar(160) [not null]
  phone varchar(20)
  email varchar(160)
  birth_date date
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    (organization_id, full_name)
  }

  Note: 'Một dòng = một con người. Danh tính nằm ở đây, vai ở các bảng patients, doctors, users. Nguồn: R-02.'
}

Table patients {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null, ref: > organizations.id]
  person_id uuid [not null, unique, ref: - people.id]
  patient_code varchar(20) [not null, note: 'Mã hồ sơ — N-04. Duy nhất trong tổ chức CHỈ giữa các hồ sơ chưa ẩn. Cách cấp mã, mã cho hồ sơ cũ, khôi phục hồ sơ đã ẩn: chờ Q-06']
  created_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    (organization_id, patient_code) [name: 'uq_patients_org_code_active', note: 'THỰC TẾ là UNIQUE một phần, WHERE deleted_at IS NULL — DBML không viết được mệnh đề WHERE, xem Note bảng']
  }

  Note: '''
    Hồ sơ bệnh nhân. Một người tối đa một hồ sơ bệnh nhân. Nguồn: R-02, R-03, N-04.
    Ràng buộc mã hồ sơ (N-04) — viết bằng SQL vì DBML không có chỉ mục một phần:
      CREATE UNIQUE INDEX uq_patients_org_code_active ON patients (organization_id, patient_code) WHERE deleted_at IS NULL;
    Hồ sơ ẩn = đặt deleted_at (N-13): KHÔNG xóa dòng; hóa đơn, thanh toán, lịch hẹn cũ vẫn trỏ về hồ sơ này.
    Khi đặt deleted_at: lịch hẹn tương lai (starts_at > now(), status booked hoặc confirmed) tự chuyển cancelled — làm bằng trigger hoặc dịch vụ ứng dụng trong cùng transaction, không viết được bằng DBML.
    Giá trị suy ra (cố ý KHÔNG lưu): tổng số lần khám đã hoàn thành (N-10) = COUNT(appointments WHERE patient_id = id AND status = 'done'). Lưu một cột đếm sẽ lệch khi lịch hẹn bị sửa hoặc đổi trạng thái; chỉ mục (patient_id, starts_at) đủ cho cỡ vài chục lịch mỗi bệnh nhân.
  '''
}

Table doctors {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null, ref: > organizations.id]
  person_id uuid [not null, unique, ref: - people.id]
  clinic_id uuid [not null, ref: > clinics.id]
  created_at timestamptz [not null, default: `now()`]

  Note: 'Hồ sơ bác sĩ; mỗi bác sĩ thuộc một phòng khám chính. Nguồn: R-02, R-05.'
}

Table users {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null, ref: > organizations.id]
  person_id uuid [not null, ref: > people.id]
  role user_role [not null]
  login_email varchar(160) [not null]
  password_hash varchar(255) [not null]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (organization_id, login_email) [unique]
  }

  Note: 'Tài khoản đăng nhập. Một người có thể có nhiều tài khoản, mỗi vai một dòng. Nguồn: R-09.'
}

Table rooms {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null, ref: > organizations.id]
  clinic_id uuid [not null, ref: > clinics.id]
  name varchar(80) [not null]

  indexes {
    (clinic_id, name) [unique]
  }

  Note: 'Phòng khám bệnh trong một phòng khám. Nguồn: R-06.'
}

Table services {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null, ref: > organizations.id]
  code varchar(40) [not null, note: 'Mã dịch vụ, ví dụ KHAM-TQ — N-11. Dịch vụ hiện có cần được điền mã khi chuyển: chờ Q-09']
  name varchar(160) [not null]
  price numeric(12,2) [not null, note: 'Giá HIỆN HÀNH; hóa đơn không đọc cột này mà đọc appointment_services.unit_price (N-01)']
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (organization_id, code) [unique, name: 'uq_services_org_code']
  }

  Note: 'Danh mục dịch vụ và giá hiện hành. Mã dịch vụ duy nhất trong tổ chức, hai tổ chức dùng cùng mã được (N-11). Nguồn: R-07, N-11.'
}

Table doctor_schedules {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null, ref: > organizations.id]
  doctor_id uuid [not null, ref: > doctors.id]
  weekday smallint [not null, note: '1 = thứ hai … 7 = chủ nhật']
  start_time time [not null]
  end_time time [not null]

  indexes {
    (doctor_id, weekday)
  }

  Note: 'Ca làm việc cố định hằng tuần của bác sĩ. Nguồn: R-05.'
}

Table appointments {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null, ref: > organizations.id]
  clinic_id uuid [not null, ref: > clinics.id]
  patient_id uuid [not null, ref: > patients.id]
  doctor_id uuid [not null, ref: > doctors.id]
  starts_at timestamptz [not null]
  ends_at timestamptz [not null, note: 'Giờ kết thúc — N-02. Phải sau starts_at. Dòng cũ cần điền khi chuyển (Q-04)']
  status appointment_status [not null, default: 'booked']
  deposit_amount numeric(12,2) [note: 'Tiền đặt cọc, null = không cọc — N-05. Phải > 0 khi có. Một khoản duy nhất; hoàn hoặc trừ cọc chưa mô hình hóa, chờ Q-07']
  deposit_received_on date [note: 'Ngày nhận cọc — N-05. Có cùng lúc với deposit_amount hoặc cùng null']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (organization_id, clinic_id, starts_at) [note: 'Báo cáo theo chi nhánh — thay cho bảng riêng từng chi nhánh (N-19)']
    (patient_id, starts_at)
  }

  Note: '''
    Lịch hẹn khám. Mỗi lịch hẹn có đúng một bác sĩ phụ trách (R-04). Nguồn: R-03, R-04, N-02, N-05, N-09, N-19.
    Một bảng cho cả ba chi nhánh (N-19): phân biệt bằng clinic_id. Tách bảng theo chi nhánh làm hỏng khóa ngoại từ invoices, hỏng ràng buộc không trùng giờ của bác sĩ (N-02) và buộc UNION mỗi khi báo cáo toàn tổ chức (R-10, R-11).
    Ràng buộc viết bằng SQL (DBML không có):
      CREATE EXTENSION IF NOT EXISTS btree_gist;
      ALTER TABLE appointments ADD CONSTRAINT ck_appointments_time_order CHECK (ends_at > starts_at);
      ALTER TABLE appointments ADD CONSTRAINT ex_appointments_doctor_no_overlap
        EXCLUDE USING gist (doctor_id WITH =, tstzrange(starts_at, ends_at, '[)') WITH &&) WHERE (status <> 'cancelled');
      ALTER TABLE appointments ADD CONSTRAINT ck_appointments_deposit
        CHECK ((deposit_amount IS NULL) = (deposit_received_on IS NULL) AND (deposit_amount IS NULL OR deposit_amount > 0));
    Khoảng nửa mở [): lịch kết thúc 09:30 và lịch bắt đầu 09:30 của cùng bác sĩ không bị coi là trùng. Lịch hủy không chiếm giờ.
    Chuyển trạng thái đã chốt từ N-09: booked → confirmed | cancelled; confirmed → arrived | no_show. Các cạnh còn lại (confirmed → cancelled theo R-12? arrived → done?) CHỜ Q-08 nên chưa cưỡng chế ở CSDL; ứng dụng không được tự đoán.
    Ca khám nhóm nhiều bác sĩ (N-16) mâu thuẫn R-04 — chưa dựng, chờ Q-11; nếu được duyệt thì ràng buộc không trùng giờ phải chuyển sang bảng người tham gia.
  '''
}

Table appointment_services {
  appointment_id uuid [not null, ref: > appointments.id]
  service_id uuid [not null, ref: > services.id]
  quantity smallint [not null, default: 1]
  unit_price numeric(12,2) [not null, note: 'Giá một đơn vị CHỐT lúc khám — N-01. Sao từ services.price khi thêm dòng; sau đó không đổi theo bảng giá']

  indexes {
    (appointment_id, service_id) [pk]
  }

  Note: '''
    Dịch vụ được thực hiện trong một lịch hẹn. Nguồn: R-07, N-01.
    unit_price là bản chụp (snapshot) giá: hóa đơn in quantity × unit_price của dòng này. Thời điểm chốt chính xác (lúc đặt hay lúc khám) chờ Q-03.
    Giá trị suy ra (cố ý KHÔNG lưu): tổng tiền hóa đơn = SUM(quantity × unit_price) của các dòng thuộc lịch hẹn. Lý do không lưu đổi so với v1.0: không còn vì giá đổi mà vì tránh một con số thứ hai có thể lệch khỏi các dòng.
  '''
}

Table invoices {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null, ref: > organizations.id]
  appointment_id uuid [not null, unique, ref: - appointments.id, note: 'Một lịch hẹn tối đa một hóa đơn (R-08); chỉ mục duy nhất này cũng là đường tra theo lịch hẹn (N-12)']
  issued_at timestamptz [not null, default: `now()`]

  Note: '''
    Hóa đơn của một lịch hẹn. Nguồn: R-08, N-12, N-13.
    Tra theo bệnh nhân (N-12): invoices JOIN appointments ON appointment_id, lọc appointments.patient_id; dùng chỉ mục (patient_id, starts_at) của appointments rồi chỉ mục duy nhất appointment_id — hai bước theo khóa, nhanh ở hàng triệu hóa đơn. KHÔNG thêm patient_id vào invoices: một cột sao chép có thể lệch khỏi lịch hẹn.
    Không bao giờ xóa theo bệnh nhân (N-13): khóa ngoại giữ mặc định RESTRICT, ẩn hồ sơ chỉ đặt patients.deleted_at.
  '''
}

Table payments {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null, ref: > organizations.id]
  invoice_id uuid [not null, ref: > invoices.id]
  amount numeric(12,2) [not null]
  method payment_method [not null]
  paid_at timestamptz [not null, default: `now()`]

  indexes {
    (invoice_id)
  }

  Note: 'Một khoản thanh toán cho hóa đơn. Hoàn tiền là dòng mới mang số âm. Nguồn: R-08.'
}

// ---------------------------------------------------------------------
//  v1.1 — bảng mới từ NHU-CAU-DU-LIEU-MOI.md
// ---------------------------------------------------------------------

Table guardianships {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null, ref: > organizations.id]
  guardian_person_id uuid [not null, ref: > people.id, note: 'Người bảo hộ — bất kỳ người nào, kể cả bác sĩ hay nhân viên']
  patient_id uuid [not null, ref: > patients.id, note: 'Bệnh nhân được bảo hộ']
  started_on date [not null, note: 'Bảo hộ từ ngày nào — N-03']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (patient_id, guardian_person_id, started_on) [unique, name: 'uq_guardianships_pair_start']
    (guardian_person_id) [note: 'Tra người này đang bảo hộ những ai']
  }

  Note: '''
    Quan hệ bảo hộ: ai (people) bảo hộ ai (patients), từ ngày nào. Nguồn: N-03.
    Một người đồng thời là lễ tân, bệnh nhân, bác sĩ đã được R-02 phủ (people là danh tính duy nhất) — bảng này chỉ thêm quan hệ giữa hai người.
    Chưa có ngày kết thúc: bảo hộ chấm dứt khi nào và có nhiều người bảo hộ cùng lúc không — chờ Q-05. Người bảo hộ không được chính là person của bệnh nhân (so sánh hai bảng, cưỡng chế bằng trigger hoặc ứng dụng).
  '''
}

Table specialties {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null, ref: > organizations.id]
  name varchar(120) [not null]
  is_active boolean [not null, default: true, note: 'Quản trị viên "bớt" chuyên khoa = đặt false, không xóa dòng; bác sĩ đã gắn vẫn giữ liên kết lịch sử']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (organization_id, `lower(name)`) [unique, name: 'uq_specialties_org_name']
  }

  Note: 'Danh mục chuyên khoa do quản trị viên tự thêm bớt — là bảng dữ liệu, không phải enum, vì danh sách đổi bằng màn hình quản trị không cần phát hành. Nguồn: N-08.'
}

Table doctor_specialties {
  organization_id uuid [not null, ref: > organizations.id]
  doctor_id uuid [not null, ref: > doctors.id]
  specialty_id uuid [not null, ref: > specialties.id]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (doctor_id, specialty_id) [pk]
    (specialty_id, doctor_id) [note: 'Chiều ngược: tìm bác sĩ theo chuyên khoa']
  }

  Note: 'Bác sĩ thuộc nhiều chuyên khoa, mỗi chuyên khoa nhiều bác sĩ (N-N). Nguồn: N-08.'
}

Table allergens {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null, ref: > organizations.id]
  name varchar(160) [not null, note: 'Tên chất gây dị ứng']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (organization_id, `lower(name)`) [unique, name: 'uq_allergens_org_name']
  }

  Note: 'Danh mục chất gây dị ứng. Có bảng riêng để tra "bệnh nhân dị ứng chất X" chính xác — nếu mỗi dòng dị ứng gõ tên tự do thì penicillin, Penicillin, pen sẽ thành ba chất khác nhau. Nguồn: N-07.'
}

Table patient_allergies {
  organization_id uuid [not null, ref: > organizations.id]
  patient_id uuid [not null, ref: > patients.id]
  allergen_id uuid [not null, ref: > allergens.id]
  severity allergy_severity [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (patient_id, allergen_id) [pk]
    (allergen_id, patient_id) [note: 'Chiều ngược: lễ tân tra bệnh nhân theo chất gây dị ứng (N-07)']
  }

  Note: 'Dị ứng của bệnh nhân: nhiều dòng mỗi bệnh nhân, mỗi chất một dòng, kèm mức nặng hoặc nhẹ. Nguồn: N-07.'
}

Table patient_insurances {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null, ref: > organizations.id]
  patient_id uuid [not null, unique, ref: - patients.id, note: 'unique = tối đa một hồ sơ bảo hiểm mỗi bệnh nhân (N-15)']
  policy_number varchar(40) [not null, note: 'Số thẻ']
  insurer_name varchar(160) [not null, note: 'Nhà bảo hiểm']
  expires_on date [not null, note: 'Hạn dùng']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Hồ sơ bảo hiểm, quan hệ 1 – 0..1 với bệnh nhân. Nhà bảo hiểm để dạng tên vì chưa có yêu cầu thống kê theo nhà bảo hiểm; có thì tách danh mục sau. Nguồn: N-15.'
}

Table internal_notes {
  id uuid [pk, default: `gen_random_uuid()`]
  organization_id uuid [not null, ref: > organizations.id]
  appointment_id uuid [ref: > appointments.id]
  patient_id uuid [ref: > patients.id]
  invoice_id uuid [ref: > invoices.id]
  body text [not null]
  created_by uuid [not null, ref: > users.id]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (appointment_id, created_at) [note: 'Thực tế nên là chỉ mục một phần WHERE appointment_id IS NOT NULL']
    (patient_id, created_at) [note: 'Thực tế nên là chỉ mục một phần WHERE patient_id IS NOT NULL']
    (invoice_id, created_at) [note: 'Thực tế nên là chỉ mục một phần WHERE invoice_id IS NOT NULL']
  }

  Note: '''
    Ghi chú nội bộ của nhân viên, gắn vào đúng MỘT trong ba đối tượng: lịch hẹn, bệnh nhân hoặc hóa đơn. Nguồn: N-06.
    Ba cột khóa ngoại thật (không dùng cặp object_type + object_id) để CSDL giữ được toàn vẹn tham chiếu:
      ALTER TABLE internal_notes ADD CONSTRAINT ck_internal_notes_one_target CHECK (num_nonnulls(appointment_id, patient_id, invoice_id) = 1);
    Ai được xem ghi chú theo phạm vi phòng khám của lễ tân (R-10): chờ Q-15.
  '''
}
